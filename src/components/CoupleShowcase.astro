---
export interface Story {
  image: string;
  title: string;
  couple: string;
  desc: string;
}

const stories: Story[] = [
  {
    image: '/images/pengantin-kotak-hadiah.png',
    title: 'A Wedding Day, Forever Kept',
    couple: 'Ranty Maria & Rayn Wijaya, 2026',
    desc: 'vows exchanged in Bali, cherished ever since.'
  },
  {
    image: '/images/momen-hangat-pengantin.png',
    title: 'Warmth in Every Detail',
    couple: 'Kevin & Natasha, 2026',
    desc: 'sentuhan personal di setiap bingkisan, menyampaikan rasa terima kasih terdalam.'
  },
  {
    image: '/images/romansa-cahaya-lilin.png',
    title: 'Cherished in Every Moment',
    couple: 'Dimas & Anindya, 2026',
    desc: 'kilau kebahagiaan malam pernikahan, dirangkai dengan kehangatan rasa.'
  },
  {
    image: '/images/langkah-pengantin-taman.png',
    title: 'Together in Every Step',
    couple: 'Aditya & Clarissa, 2026',
    desc: 'langkah awal perjalanan cinta di Malang, berbagi sukacita penuh makna.'
  }
];
---

<section class="couple-section" aria-label="Cerita Pernikahan Bersama Sekata">
  <div class="couple-slider" id="coupleSlider">
    <!-- Pojok Kanan Atas: Logo Sekata (Sesuai Referensi Howel & Co) -->
    <div class="couple-logo-badge">
      <img src="/images/logo-light.png" alt="Logo Sekata" width="140" height="46" class="couple-logo-img" style="height:38px;width:auto;object-fit:contain;display:block;" />
    </div>

    <!-- Slide Foto Pasangan -->
    <div class="couple-slides">
      {stories.map((story, index) => (
        <div class={`couple-slide ${index === 0 ? 'active' : ''}`} data-index={index}>
          <img
            src={story.image}
            alt={`${story.title} - ${story.couple}`}
            class="couple-slide-img"
            loading={index === 0 ? 'eager' : 'lazy'}
          />
          <div class="couple-slide-shade"></div>
          <div class="couple-slide-content">
            <h2 class="couple-slide-title">{story.title}</h2>
            <p class="couple-slide-meta">
              <strong>{story.couple}</strong> — {story.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Tombol Navigasi Kiri & Kanan (Kotak Putih Elegan seperti Contoh) -->
    <button class="couple-nav-btn prev" id="couplePrev" aria-label="Foto sebelumnya">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5M12 19l-7-7 7-7" />
      </svg>
    </button>
    <button class="couple-nav-btn next" id="coupleNext" aria-label="Foto berikutnya">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M12 5l7 7-7 7" />
      </svg>
    </button>

    <!-- Indikator Slide -->
    <div class="couple-dots" id="coupleDots">
      {stories.map((_, index) => (
        <button
          class={`couple-dot ${index === 0 ? 'active' : ''}`}
          data-slide-to={index}
          aria-label={`Lihat slide ${index + 1}`}
        ></button>
      ))}
    </div>
  </div>
</section>

<style>
  .couple-section {
    position: relative;
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: #1e1713;
  }

  .couple-slider {
    position: relative;
    width: 100%;
    height: 640px;
    overflow: hidden;
  }

  /* Logo Sekata di Pojok Kanan Atas */
  .couple-logo-badge {
    position: absolute;
    top: 36px;
    right: 48px;
    z-index: 15;
    display: flex;
    align-items: center;
    gap: 14px;
    background: rgba(26, 19, 15, 0.45);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
  }

  .couple-logo-img {
    width: 36px;
    height: 36px;
    object-fit: contain;
    border-radius: 50%;
  }

  .couple-brand-text {
    font-family: 'Poppins', sans-serif;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: #ffffff;
    text-transform: uppercase;
  }

  /* Slides */
  .couple-slides {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .couple-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s ease-in-out, visibility 0.8s ease-in-out;
    z-index: 1;
  }

  .couple-slide.active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }

  .couple-slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
  }

  /* Shade & Gradient Overlay */
  .couple-slide-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(24, 18, 14, 0.45) 0%,
      rgba(24, 18, 14, 0.05) 35%,
      rgba(24, 18, 14, 0.25) 60%,
      rgba(24, 18, 14, 0.88) 100%
    );
  }

  /* Konten Judul di Pojok Kiri Bawah */
  .couple-slide-content {
    position: absolute;
    bottom: 48px;
    left: 6%;
    max-width: 820px;
    z-index: 10;
    color: #ffffff;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.6);
  }

  .couple-slide-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 48px;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 14px;
    color: #ffffff;
  }

  .couple-slide-meta {
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    color: #eee4d9;
    line-height: 1.6;
    margin: 0;
    font-weight: 300;
  }

  .couple-slide-meta strong {
    font-weight: 500;
    color: #ffffff;
  }

  /* Navigasi Kiri & Kanan (Kotak Putih Elegan) */
  .couple-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 20;
    width: 48px;
    height: 48px;
    background: rgba(255, 255, 255, 0.92);
    border: none;
    border-radius: 4px;
    display: grid;
    place-items: center;
    color: #2b2019;
    cursor: pointer;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
    transition: background 0.2s, transform 0.2s, opacity 0.2s;
  }

  .couple-nav-btn:hover {
    background: #ffffff;
    transform: translateY(-50%) scale(1.08);
  }

  .couple-nav-btn:active {
    transform: translateY(-50%) scale(0.96);
  }

  .couple-nav-btn.prev {
    left: 24px;
  }

  .couple-nav-btn.next {
    right: 24px;
  }

  /* Indikator Titik di Bawah */
  .couple-dots {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 20;
  }

  .couple-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: width 0.3s ease, background 0.3s ease, border-radius 0.3s ease;
  }

  .couple-dot.active {
    width: 26px;
    border-radius: 5px;
    background: #ffffff;
  }

  /* Responsif Tablet & HP */
  @media (max-width: 900px) {
    .couple-slider {
      height: 520px;
    }
    .couple-slide-title {
      font-size: 38px;
    }
    .couple-logo-badge {
      top: 24px;
      right: 24px;
      padding: 6px 14px;
    }
    .couple-logo-img {
      width: 30px;
      height: 30px;
    }
    .couple-brand-text {
      font-size: 13px;
    }
  }

  @media (max-width: 600px) {
    .couple-slider {
      height: 480px;
    }
    .couple-slide-content {
      bottom: 40px;
      left: 20px;
      right: 20px;
    }
    .couple-slide-title {
      font-size: 30px;
      margin-bottom: 8px;
    }
    .couple-slide-meta {
      font-size: 13px;
      line-height: 1.5;
    }
    .couple-logo-badge {
      top: 18px;
      right: 18px;
      padding: 5px 12px;
      gap: 10px;
    }
    .couple-brand-text {
      font-size: 12px;
    }
    .couple-nav-btn {
      width: 40px;
      height: 40px;
    }
    .couple-nav-btn.prev {
      left: 12px;
    }
    .couple-nav-btn.next {
      right: 12px;
    }
  }
</style>

<script>
  function setupCoupleSlider() {
    const slider = document.getElementById('coupleSlider');
    if (!slider) return;
    if ((slider as any)._initialized) return;
    (slider as any)._initialized = true;

    const slides = Array.from(slider.querySelectorAll<HTMLElement>('.couple-slide'));
    const dots = Array.from(slider.querySelectorAll<HTMLElement>('.couple-dot'));
    const prevBtn = document.getElementById('couplePrev');
    const nextBtn = document.getElementById('coupleNext');

    if (!slides.length) return;

    let current = 0;
    let timer: number | undefined;

    function goTo(index: number) {
      slides[current].classList.remove('active');
      if (dots[current]) dots[current].classList.remove('active');

      current = (index + slides.length) % slides.length;

      slides[current].classList.add('active');
      if (dots[current]) dots[current].classList.add('active');
    }

    function next() {
      goTo(current + 1);
    }

    function prev() {
      goTo(current - 1);
    }

    function startAuto() {
      stopAuto();
      timer = window.setInterval(next, 5000);
    }

    function stopAuto() {
      if (timer) {
        clearInterval(timer);
        timer = undefined;
      }
    }

    prevBtn?.addEventListener('click', () => {
      prev();
      startAuto();
    });

    nextBtn?.addEventListener('click', () => {
      next();
      startAuto();
    });

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        goTo(idx);
        startAuto();
      });
    });

    slider.addEventListener('mouseenter', stopAuto);
    slider.addEventListener('mouseleave', startAuto);

    // Touch Swipe untuk ponsel
    let touchStartX = 0;
    slider.addEventListener(
      'touchstart',
      (e) => {
        touchStartX = e.changedTouches[0].screenX;
        stopAuto();
      },
      { passive: true }
    );

    slider.addEventListener(
      'touchend',
      (e) => {
        const touchEndX = e.changedTouches[0].screenX;
        const diff = touchEndX - touchStartX;
        if (Math.abs(diff) > 40) {
          if (diff < 0) next();
          else prev();
        }
        startAuto();
      },
      { passive: true }
    );

    startAuto();
  }

  setupCoupleSlider();
  document.addEventListener('astro:page-load', setupCoupleSlider);
</script>

