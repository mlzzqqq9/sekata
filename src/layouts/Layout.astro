---
import '@fontsource/poppins/400.css';import '@fontsource/poppins/500.css';import '@fontsource/poppins/600.css';
import '../styles/global.css';import Icon from '../components/Icon.astro';import {categories,hampers,souvenirs,slug,wa,map,config} from '../data/site';
const {title='Sekata — Souvenir Pernikahan & Hampers Custom Malang',description='Sekata membantu memilih souvenir pernikahan, hampers, dan gift custom dari Malang. Konsultasikan pilihan isi dan kemasan bersama Ayu.',schema}=Astro.props;
const canonical=new URL(Astro.url.pathname,'https://sekata.web.id').href;
const org={
  '@context':'https://schema.org',
  '@type':'Store',
  '@id':'https://sekata.web.id/#organization',
  name:'Sekata',
  url:'https://sekata.web.id',
  telephone:'+6282131087971',
  priceRange:'$$',
  image:'https://sekata.web.id/images/logo.webp',
  address:{
    '@type':'PostalAddress',
    streetAddress:'Cemorokandang',
    addressLocality:'Malang',
    addressRegion:'Jawa Timur',
    postalCode:'65138',
    addressCountry:'ID'
  },
  geo:{
    '@type':'GeoCoordinates',
    latitude:-7.9907544,
    longitude:112.6804383
  },
  hasMap:map,
  aggregateRating:{
    '@type':'AggregateRating',
    ratingValue:'4.9',
    reviewCount:'128',
    bestRating:'5',
    worstRating:'1'
  }
};
---
<!doctype html><html lang="id"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" type="image/webp" href="/images/logo.webp"/><meta name="theme-color" content="#aa5636"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content="https://sekata.web.id/images/hero.jpg"/><meta name="twitter:card" content="summary_large_image"/><script type="application/ld+json" set:html={JSON.stringify(org)}/>{schema&&<script type="application/ld+json" set:html={JSON.stringify(schema)}/>}</head><body>
<div id="splash-screen" class="splash-screen" aria-hidden="true" style="position:fixed;inset:0;z-index:99999;background:#faf8f3;display:flex;align-items:center;justify-content:center;">
  <div class="splash-content">
    <div class="splash-logo-wrap">
      <img src="/images/logo-dark.png" alt="Sekata" width="220" height="74" class="splash-logo" />
    </div>
  </div>
</div>
<script is:inline>
  (function() {
    function hideSplash() {
      var splash = document.getElementById('splash-screen');
      if (splash && !splash.classList.contains('splash-hidden')) {
        splash.classList.add('splash-hidden');
        setTimeout(function() {
          if (splash && splash.parentNode) {
            splash.parentNode.removeChild(splash);
          }
        }, 750);
      }
    }
    if (document.readyState === 'complete') {
      setTimeout(hideSplash, 1100);
    } else {
      window.addEventListener('load', function() {
        setTimeout(hideSplash, 1000);
      });
      setTimeout(hideSplash, 2500);
    }
  })();
</script>
<a class="skip" href="#main">Lewati ke konten</a><div class="announcement">Dari sebuah perhatian, menjadi kenangan. <a href={wa}>Temukan hadiahmu </a></div>
<header class="site-header is-transparent" id="siteHeader"><nav class="desktop-nav" aria-label="Navigasi utama"><a href="/" aria-current={Astro.url.pathname==='/'?'page':undefined}>Beranda</a><details class="mega"><summary>Gift <Icon name="chevron" size={14}/></summary><div class="mega-content"><div><span class="eyebrow">A LITTLE SOMETHING, A LOT OF MEANING.</span><h2>Untuk setiap<br/>cerita berharga.</h2><a class="text-link" href="/gift/">Jelajahi semua gift <Icon/></a></div><div><a class="menu-heading" href="/hampers/">Hampers</a>{hampers.map(n=><a href={'/hampers-'+slug(n)+'/'}>Hampers {n}</a>)}</div><div><a class="menu-heading" href="/souvenir/">Souvenir</a>{souvenirs.slice(0,6).map(n=><a href={'/souvenir-'+slug(n)+'/'}>Souvenir {n}</a>)}</div><div><span class="menu-heading">Untuk acara & perusahaan</span>{souvenirs.slice(6).map(n=><a href={'/souvenir-'+slug(n)+'/'}>Souvenir {n}</a>)}</div></div></details><a href="/sekata/">Sekata</a><a href="/blog/" aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}>Temukan Solusi</a></nav><a href="/" class="brand" aria-label="Sekata Beranda"><img src="/images/logo-light.png" width="140" height="46" alt="sekata" class="brand-logo logo-light"/><img src="/images/logo-dark.png" width="140" height="46" alt="sekata" class="brand-logo logo-dark"/></a><div class="nav-actions"><button class="icon-button" id="open-search" aria-label="Cari produk dan artikel"><Icon name="search"/></button><button class="icon-button bag-button" id="open-cart" aria-label="Buka keranjang"><Icon name="bag"/><span id="cart-count">0</span></button><button class="icon-button mobile-toggle" id="open-menu" aria-label="Buka menu"><Icon name="menu"/></button></div></header>
<main id="main"><slot/></main>
<section class="closing"><span class="eyebrow">LET'S MAKE IT MEANINGFUL</span><h2>Setiap momen punya cerita.<br/>Mari beri sesuatu yang bermakna.</h2><a class="button light" href={wa+'?text='+encodeURIComponent('Halo Kak Ayu, saya ingin konsultasi souvenir di Sekata.')}>Ceritakan kebutuhanmu <Icon/></a></section>
<footer><div class="footer-top"><div class="footer-about"><a class="footer-wordmark" href="/" aria-label="Sekata Beranda"><img src="/images/logo-dark.png" alt="sekata" width="140" height="46" style="height:40px;width:auto;max-width:150px;object-fit:contain;display:block;"/></a><p>Hadiah yang menyampaikan rasa.<br/>Souvenir dan hampers untuk momen<br/>yang ingin selalu dikenang.</p><div class="socials">{(['instagram','tiktok','email'] as const).map(s=>config.social[s]?<a href={s==='email'?'mailto:'+config.social[s]:config.social[s]} aria-label={s}><Icon name={s==='email'?'mail':s}/></a>:<span title={s+' segera tersedia'} aria-label={s+' belum tersedia'}><Icon name={s==='email'?'mail':s}/></span>)}</div></div><div><h3>Jelajahi Sekata</h3><a href="/">Beranda</a><a href="/gift/">Gift</a><a href="/hampers/">Hampers</a><a href="/souvenir/">Souvenir</a><a href="/testimonials/">Testimonials</a><a href="/faq/">FAQ</a><a href="/sekata/">Tentang Kami</a><a href="/blog/">Temukan Solusi</a></div><div><h3>Untuk momenmu</h3>{categories.filter((_,i)=>[0,3,4,5,10,11,14,15].includes(i)).map(c=><a href={'/'+c.slug+'/'}>{c.name}</a>)}</div><div><h3>Mari terhubung</h3><a href={wa}>Ayu · +62 821-3108-7971</a><p>Cemorokandang, Malang<br/>Jawa Timur, Indonesia 65138</p><a class="text-link" href={map} target="_blank" rel="noopener noreferrer">Lihat peta <Icon size={16}/></a><a href="/kontak/">Kontak Sekata</a></div></div><details class="footer-categories"><summary>Semua kategori gift</summary><div>{categories.map(c=><a href={'/'+c.slug+'/'}>{c.name}</a>)}</div></details><div class="footer-bottom"><span>© {new Date().getFullYear()} Sekata. Semua hak dilindungi.</span><div><a href="/kebijakan-privasi/">Kebijakan Privasi</a><a href="/syarat-ketentuan/">Syarat & Ketentuan</a></div><span>Made for meaningful moments.</span></div></footer>
<a class="floating-chat" href={wa} aria-label="Chat dengan Ayu di WhatsApp"><Icon name="chat"/></a>
<dialog id="search-dialog"><div class="dialog-head"><h2>Temukan sesuatu yang berarti.</h2><button class="icon-button" data-close aria-label="Tutup pencarian"><Icon name="close"/></button></div><label for="search-input">Cari produk, kategori, atau inspirasi</label><input id="search-input" type="search" placeholder="Coba: wedding, hampers, keramik…"/><div id="search-results"></div></dialog>
<dialog id="cart-dialog" class="cart-dialog"><div class="dialog-head"><h2>Pilihan hadiahmu</h2><button class="icon-button" data-close aria-label="Tutup keranjang"><Icon name="close"/></button></div><p>Pilih inspirasi, atur jumlah, lalu konsultasikan detail dan harga bersama Ayu.</p><div id="cart-items"></div><label for="cart-notes">Catatan acara</label><textarea id="cart-notes" placeholder="Tanggal acara, kota tujuan, atau detail personalisasi"></textarea><a id="cart-checkout" class="button" href={wa}>Konsultasikan via WhatsApp <Icon/></a></dialog>
<dialog id="mobile-menu"><div class="dialog-head"><span class="eyebrow">SEKATA</span><button class="icon-button" data-close aria-label="Tutup menu"><Icon name="close"/></button></div><a href="/">Beranda</a><a href="/gift/">Semua Gift</a><details><summary>Hampers</summary>{hampers.map(n=><a href={'/hampers-'+slug(n)+'/'}>Hampers {n}</a>)}</details><details><summary>Souvenir</summary>{souvenirs.map(n=><a href={'/souvenir-'+slug(n)+'/'}>Souvenir {n}</a>)}</details><a href="/sekata/">Sekata</a><a href="/blog/">Temukan Solusi</a><a href="/kontak/">Kontak</a></dialog><div id="toast" role="status"></div>
<script>
import {products,categories,articles,wa} from '../data/site';
let cart: {id:string;name:string;qty:number;image?:string}[]=[];try{cart=JSON.parse(localStorage.getItem('sekata-cart')||'[]');if(!Array.isArray(cart))cart=[];}catch{}
const $=(s:string)=>document.querySelector(s) as HTMLElement;
function update(){localStorage.setItem('sekata-cart',JSON.stringify(cart));$('#cart-count').textContent=String(cart.reduce((n,p)=>n+p.qty,0));const box=$('#cart-items');box.replaceChildren();if(!cart.length){box.textContent='Belum ada pilihan. Jelajahi koleksi dan tambahkan inspirasi yang kamu suka.';}cart.forEach(p=>{const prod=products.find(x=>x.id===p.id);const imgUrl='/images/'+(p.image||prod?.image||'hero.jpg');const row=document.createElement('div');row.className='cart-row';const img=document.createElement('img');img.src=imgUrl;img.alt=p.name;img.className='cart-item-img';img.width=54;img.height=54;img.loading='lazy';const info=document.createElement('div');info.className='cart-item-info';const label=document.createElement('strong');label.textContent=p.name;info.append(label);const input=document.createElement('input');input.type='number';input.min='1';input.max='100000';input.value=String(p.qty);input.setAttribute('aria-label','Jumlah '+p.name);input.addEventListener('change',()=>{p.qty=Math.min(100000,Math.max(1,Math.floor(Number(input.value)||1)));update()});const remove=document.createElement('button');remove.textContent='Hapus';remove.addEventListener('click',()=>{cart=cart.filter(x=>x.id!==p.id);update()});row.append(img,info,input,remove);box.append(row)});const notes=($('#cart-notes') as HTMLTextAreaElement).value;const msg='Halo Kak Ayu, saya ingin konsultasi pilihan gift Sekata:\n'+cart.map(p=>'- '+p.name+' — '+p.qty+' pcs').join('\n')+'\n\nCatatan: '+notes+'\nMohon informasi pilihan isi, harga, minimum pesanan, dan estimasi produksi.';($('#cart-checkout') as HTMLAnchorElement).href=wa+'?text='+encodeURIComponent(msg);}
update();$('#cart-notes').addEventListener('input',update);document.querySelectorAll('.add-product').forEach(b=>b.addEventListener('click',()=>{const id=(b as HTMLElement).dataset.id!;const p=products.find(p=>p.id===id)!;const item=cart.find(x=>x.id===id);if(item)item.qty++;else cart.push({id,name:p.name,qty:1,image:p.image});update();$('#toast').textContent=p.name+' ditambahkan ke pilihan';$('#toast').classList.add('show');setTimeout(()=>$('#toast').classList.remove('show'),2400)}));
[['#open-search','#search-dialog'],['#open-cart','#cart-dialog'],['#open-menu','#mobile-menu']].forEach(([b,d])=>$(b).addEventListener('click',()=>($(d) as HTMLDialogElement).showModal()));document.querySelectorAll('[data-close]').forEach(b=>b.addEventListener('click',()=>b.closest('dialog')?.close()));document.querySelectorAll('dialog').forEach(d=>d.addEventListener('click',e=>{if(e.target===d){const r=d.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)d.close()}}));
const entries=[...products.map(p=>({name:p.name+' '+p.kind,url:'/'+(p.categorySlug || (p.kind.toLowerCase().includes('lebaran') ? 'hampers-lebaran' : p.kind.toLowerCase().includes('wedding') ? 'souvenir-wedding' : p.kind.toLowerCase().includes('haji') || p.kind.toLowerCase().includes('umrah') ? 'souvenir-haji-umrah' : 'produk'))+'/'+p.id+'/'})),...categories.map(c=>({name:c.name,url:'/'+c.slug+'/'})),...articles.map(a=>({name:a.title,url:'/blog/'+a.slug+'/'}))];$('#search-input').addEventListener('input',e=>{const q=(e.target as HTMLInputElement).value.trim().toLowerCase();const results=$('#search-results');results.replaceChildren();if(!q)return;const found=entries.filter(p=>p.name.toLowerCase().includes(q));if(!found.length)results.textContent='Belum ditemukan. Coba kata lain atau konsultasikan dengan Ayu.';found.forEach(p=>{const a=document.createElement('a');a.href=p.url;a.textContent=p.name;results.append(a)})});
function initNavbarTransparency(){const header=document.getElementById('siteHeader');if(!header)return;const isHome=window.location.pathname==='/'||window.location.pathname==='';function onScroll(){if(!isHome){header.classList.remove('is-transparent');header.classList.add('scrolled');return;}if(header.classList.contains('mega-open')){header.classList.remove('is-transparent');header.classList.add('scrolled');return;}if(window.scrollY<50){header.classList.add('is-transparent');header.classList.remove('scrolled');}else{header.classList.remove('is-transparent');header.classList.add('scrolled');}}window.addEventListener('scroll',onScroll,{passive:true});onScroll();const mega=header.querySelector('.mega') as HTMLDetailsElement|null;if(mega){let leaveTimer:any;mega.addEventListener('mouseenter',()=>{clearTimeout(leaveTimer);mega.open=true;header.classList.add('mega-open');header.classList.remove('is-transparent');header.classList.add('scrolled');});mega.addEventListener('mouseleave',()=>{leaveTimer=setTimeout(()=>{mega.open=false;header.classList.remove('mega-open');onScroll();},150);});}}
initNavbarTransparency();document.addEventListener('astro:page-load',initNavbarTransparency);
</script>
</body></html>
