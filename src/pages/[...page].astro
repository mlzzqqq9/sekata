          <!-- Client-Side Script Pagination Cepat & Mulus -->
          <script is:inline>
            (function() {
              var items = document.querySelectorAll('.catalog-item');
              var pagination = document.getElementById('catalogPagination');
              var rangeText = document.getElementById('catalog-range');
              var total = items.length;
              var pageSize = 12;

              function goToPage(page) {
                var start = (page - 1) * pageSize;
                var end = Math.min(start + pageSize, total);

                items.forEach(function(el, i) {
                  if (i >= start && i < end) {
                    el.style.display = '';
                  } else {
                    el.style.display = 'none';
                  }
                });

                if (rangeText) {
                  rangeText.textContent = (start + 1) + '–' + end;
                }

                if (pagination) {
                  var btn1 = document.getElementById('btnPage1');
                  var btn2 = document.getElementById('btnPage2');
                  var btnNext = document.getElementById('btnPageNext');

                  if (btn1) btn1.classList.toggle('active', page === 1);
                  if (btn2) btn2.classList.toggle('active', page === 2);
                  if (btnNext) {
                    btnNext.disabled = (page === 2);
                    btnNext.style.opacity = page === 2 ? '0.4' : '1';
                  }
                }

                var container = document.getElementById('catalog-main');
                if (container && window.scrollY > 350) {
                  container.scrollIntoView({ behavior: 'smooth' });
                }
              }

              if (pagination) {
                pagination.addEventListener('click', function(e) {
                  var target = e.target;
                  if (!target || !target.matches('.page-btn')) return;
                  var pageAttr = target.getAttribute('data-page');
                  if (pageAttr === '1') {
                    goToPage(1);
                  } else if (pageAttr === '2') {
                    goToPage(2);
                  } else if (pageAttr === 'next') {
                    goToPage(2);
                  }
                });

                var urlParams = new URLSearchParams(window.location.search);
                if (urlParams.get('page') === '2' || urlParams.get('p') === '2') {
                  goToPage(2);
                }
              }
            })();
          </script>

