---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import { categories, products, articles, wa, map } from '../data/site';

export function getStaticPaths() {
  return [
    'gift',
    'hampers',
    'souvenir',
    'sekata',
    'kontak',
    'blog',
    'temukan-solusi',
    'kebijakan-privasi',
    'syarat-ketentuan',
    'penulis/m-maulana-ishaq',
    // Rute redirect artikel kluster ke blog
    'souvenir-wedding-aesthetic',
    'souvenir-wedding-earth-tone',
    'souvenir-wedding-emboss-vs-printing',
    // Rute kategori mandiri tingkat atas (contoh: /hampers-lebaran/, /souvenir-wedding/)
    ...categories.map((c) => c.slug),
    // Rute dengan prefix /gift/ untuk kompatibilitas tautan lama agar tidak ada yang 404
    ...categories.map((c) => 'gift/' + c.slug)
  ].map((page) => ({ params: { page } }));
}

const { page } = Astro.params;

// Redirect otomatis dari format lama /temukan-solusi/ ke format baru /blog/
if (page === 'temukan-solusi') {
  return Astro.redirect('/blog/', 301);
}

// Redirect otomatis artikel kluster ke /blog/[slug-baru]/
if (page === 'souvenir-wedding-aesthetic') {
  return Astro.redirect('/blog/desain-souvenir-wedding-modern/', 301);
}
if (page === 'souvenir-wedding-earth-tone') {
  return Astro.redirect('/blog/warna-souvenir-wedding-earth-tone/', 301);
}
if (page === 'souvenir-wedding-emboss-vs-printing') {
  return Astro.redirect('/blog/emboss-vs-printing-souvenir-wedding/', 301);
}

// Redirect otomatis dari format lama /gift/[kategori]/ ke format baru /[kategori]/
if (page && page.startsWith('gift/')) {
  const catSlug = page.replace('gift/', '');
  return Astro.redirect('/' + catSlug + '/', 301);
}

const category = categories.find((c) => c.slug === page);
const isCatalog = category || ['gift', 'hampers', 'souvenir'].includes(page!);

const titles: Record<string, string> = {
  gift: 'Hadiah untuk setiap cerita.',
  hampers: 'Sebungkus perhatian, sepenuh hati.',
  souvenir: 'Kenangannya tinggal lebih lama.',
  sekata: 'Kita bertemu dalam satu rasa.',
  kontak: 'Ceritakan kebutuhanmu.',
  blog: 'Inspirasi untuk momen berarti.',
  'temukan-solusi': 'Inspirasi untuk momen berarti.',
  'kebijakan-privasi': 'Kebijakan Privasi',
  'syarat-ketentuan': 'Syarat & Ketentuan',
  'penulis/m-maulana-ishaq': 'M. Maulana Ishaq'
};

const title = category?.name || titles[page!] || 'Sekata';
const desc = category
  ? `Konsultasikan ${category.name.toLowerCase()} bersama Sekata di Malang. Pilihan custom logo, paket fleksibel, dan pengiriman Malang, Batu, Kepanjen & seluruh Jawa Timur.`
  : isCatalog
  ? 'Temukan inspirasi souvenir, hampers, dan gift personal. Custom logo, paket fleksibel, serta pengiriman Malang, Batu, Kepanjen & seluruh Indonesia bersama Ayu.'
  : 'Cerita, informasi, dan layanan Sekata untuk membantu menyiapkan hadiah yang bermakna.';

const activeSlug = category ? category.slug : page;
const isHampersLebaran = activeSlug === 'hampers-lebaran' || activeSlug === 'gift/hampers-lebaran';
const isWedding = activeSlug === 'souvenir-wedding' || activeSlug === 'gift/souvenir-wedding' || activeSlug === 'hampers-wedding';
const isHajiUmrah = activeSlug === 'souvenir-haji-umrah' || activeSlug === 'gift/souvenir-haji-umrah';

let relevant: typeof products = [];

if (isHampersLebaran) {
  // Hanya produk Hampers Lebaran murni (jangan dicampur!)
  relevant = products.filter((p) => p.categorySlug === 'hampers-lebaran' || p.kind.toLowerCase().includes('lebaran'));
} else if (isWedding) {
  // Hanya produk Wedding Souvenir murni
  relevant = products.filter((p) => p.categorySlug === 'souvenir-wedding' || p.kind.toLowerCase().includes('wedding'));
} else if (isHajiUmrah) {
  // Hanya produk Haji & Umrah murni
  relevant = products.filter((p) => p.categorySlug === 'souvenir-haji-umrah' || p.kind.toLowerCase().includes('haji') || p.kind.toLowerCase().includes('umrah'));
} else if (page === 'souvenir') {
  relevant = products.filter((p) => p.kind.toLowerCase().includes('souvenir'));
} else if (page === 'hampers') {
  relevant = products.filter((p) => p.kind.toLowerCase().includes('hampers'));
} else if (page === 'gift') {
  relevant = products;
} else if (category) {
  // Kategori lain yang belum memiliki kurasi produk: KOSONGKAN DULU (JANGAN DIPAKSAKAN CAMPUR)
  relevant = products.filter((p) => p.categorySlug === category.slug);
} else {
  relevant = products;
}

// Schema.org CollectionPage / WebPage yang valid menurut pedoman Google Rich Results
const catalogSchema = {
  '@context': 'https://schema.org',
  '@type': isCatalog ? 'CollectionPage' : 'WebPage',
  'name': (category?.name || titles[page!] || 'Sekata') + ' | Sekata Malang',
  'description': desc,
  'url': 'https://sekata.web.id/' + (page ? page + '/' : ''),
  'isPartOf': {
    '@id': 'https://sekata.web.id/#organization'
  },
  ...(isCatalog && relevant.length > 0 ? {
    'mainEntity': {
      '@type': 'ItemList',
      'numberOfItems': Math.min(relevant.length, 12),
      'itemListElement': relevant.slice(0, 12).map((prod, index) => ({
        '@type': 'ListItem',
        'position': index + 1,
        'name': prod.name,
        'url': 'https://sekata.web.id/' + (prod.categorySlug || 'gift') + '/' + prod.id + '/'
      }))
    }
  } : {})
};

// FAQ khusus kategori dinamis sesuai halaman aktif (humanis, formal & tanpa emoji)
const categoryName = category?.name || (page === 'hampers' ? 'Hampers' : page === 'souvenir' ? 'Souvenir' : 'Gift');

let categoryFaqs = [
  {
    q: `Berapa minimum pemesanan (MOQ) untuk ${categoryName.toLowerCase()}?`,
    a: `Pemesanan ${categoryName.toLowerCase()} di Sekata sangat fleksibel, mulai dari 25–50 pcs untuk acara keluarga hingga ratusan atau ribuan pcs untuk perayaan besar dan instansi korporat. Konsultasikan langsung pagu kebutuhanmu bersama Ayu.`
  },
  {
    q: `Bisa kustomisasi logo, inisial monogram, dan kartu ucapan?`,
    a: `Tentu saja. Kami menyediakan layanan kustomisasi penuh mencakup inisial monogram foil emas, grafir deboss kulit, pilihan warna kemasan, hingga kartu ucapan dengan kalimat hangat yang dipersonalisasi khusus sesuai acaramu.`
  },
  {
    q: `Berapa lama estimasi pengerjaan ${categoryName.toLowerCase()}?`,
    a: `Waktu pengerjaan berkisar antara 10–25 hari kerja setelah approval mockup desain dan konfirmasi DP. Untuk kebutuhan mendesak, kamu bisa berdiskusi langsung dengan admin Ayu untuk slot prioritas.`
  },
  {
    q: `Bagaimana jangkauan pengiriman ke Malang, Batu, Kepanjen, dan luar kota?`,
    a: `Sekata berbasis di Malang. Kami melayani pengantaran langsung untuk area Malang, Kota Batu, Kepanjen, dan sekitarnya. Untuk pengiriman ke seluruh Jawa Timur dan nusantara, kami menggunakan kargo terpercaya dengan standar proteksi packing kayu bergaransi.`
  },
  {
    q: `Apakah bisa melihat sampel fisik sebelum pesanan diproduksi massal?`,
    a: `Ya. Kami menyediakan simulasi visual mockup digital serta opsi pengiriman sampel fisik (proof sample) ke alamatmu untuk pesanan dalam jumlah tertentu agar kamu dapat mengecek langsung detail jahitan, warna, dan material.`
  }
];

if (category?.slug === 'hampers-lebaran') {
  categoryFaqs = [
    {
      q: 'Kapan waktu paling ideal untuk memesan hampers lebaran di Sekata?',
      a: 'Sangat disarankan pemesanan dilakukan H-45 hingga H-20 sebelum Hari Raya Idul Fitri. Hal ini bertujuan agar alur produksi, kustomisasi nama, serta pengiriman tiba tepat waktu sebelum cut-off jadwal ekspedisi mudik.'
    },
    {
      q: 'Apakah isi hampers lebaran bisa dikombinasikan antara kue kering dan cinderamata?',
      a: 'Sangat bisa. Konsep hampers Sekata dirancang fleksibel. Kamu dapat memadukan kue kering premium dengan souvenir fungsional seperti sajadah travel, reed diffuser, scented candle, tumbler grafir, atau pouch kulit monogram.'
    },
    {
      q: 'Apakah Sekata melayani pengiriman hampers langsung ke alamat penerima satu per satu?',
      a: 'Ya, kami melayani sistem multi-alamat langsung ke rumah kerabat, mitra bisnis, atau karyawan ke berbagai kota di Malang, Surabaya, Jabodetabek, dan seluruh Indonesia dengan packing aman bergaransi.'
    },
    {
      q: 'Bisa custom logo perusahaan atau nama keluarga di boks hampers lebaran?',
      a: 'Tentu. Kami menyediakan kemasan hardbox eksklusif dengan deboss foil emas logo perusahaan, greeting card bermotif Idul Fitri dengan ucapan personal, serta hangtag nama penerima.'
    },
    {
      q: 'Berapa minimum pemesanan hampers lebaran?',
      a: 'Pemesanan sangat fleksibel mulai dari 5–10 boks untuk hampers kurasi personal, dan penawaran harga korporat khusus untuk pemesanan massal di atas 50 boks.'
    }
  ];
} else if (category?.slug === 'souvenir-wedding' || isWedding) {
  categoryFaqs = [
    {
      q: 'Kapan sebaiknya pasangan mempelai memesan souvenir pernikahan?',
      a: 'Waktu terbaik adalah H-60 hingga H-30 sebelum hari resepsi pernikahan. Dengan waktu yang cukup, kamu bisa leluasa meninjau sampel fisik, menyesuaikan tema warna dekorasi pernikahan, dan memastikan finishing rapi.'
    },
    {
      q: 'Berapa minimum pemesanan untuk wedding souvenir?',
      a: 'Pemesanan mulai dari 50 pcs untuk intimate wedding. Untuk pemesanan 200 hingga 1.000+ pcs, kami memberikan penawaran harga khusus serta gratis personalisasi kartu ucapan dan sampel fisik pra-produksi.'
    },
    {
      q: 'Apakah souvenir sudah termasuk kemasan siap bagi (ready-to-gift)?',
      a: 'Ya, seluruh souvenir pernikahan Sekata dikirim dalam kondisi siap dibagikan kepada tamu undangan, sudah terpasang kemasan boks mika transparan atau boks eksklusif, pita satin rapi, dan thank you card.'
    },
    {
      q: 'Bagaimana jika ada souvenir yang cacat atau rusak saat pengiriman?',
      a: 'Sekata memberikan garansi pergantian unit atau kompensasi jika ditemukan cacat produksi atau kerusakan selama proses pengiriman resmi kami.'
    },
    {
      q: 'Apakah bisa kirim ke luar pulau atau venue pernikahan langsung?',
      a: 'Bisa. Kami berpengalaman mengirimkan ribuan paket souvenir ke Bali, Jakarta, Kalimantan, Sulawesi, hingga Sumatra dengan proteksi packing kayu dan pelacak kargo real-time.'
    }
  ];
} else if (category?.slug === 'souvenir-haji-umrah' || isHajiUmrah) {
  categoryFaqs = [
    {
      q: 'Souvenir apa saja yang paling diminati untuk oleh-oleh tasyakuran Haji & Umrah?',
      a: 'Pilihan terfavorit antara lain sajadah traveling saku berinisial nama, tasbih kayu premium, botol air zam-zam mini kemasan pouch, dan gift set perlengkapan ibadah dalam kemasan mika berpita.'
    },
    {
      q: 'Apakah bisa pengerjaan cepat jika kepulangan jamaah sudah dekat?',
      a: 'Bisa. Kami memiliki jalur produksi cepat untuk produk semi-ready yang dapat dikirimkan dalam 5–7 hari kerja. Silakan informasikan jadwal kedatangan jamaah kepada Ayu di WhatsApp.'
    },
    {
      q: 'Bisa disematkan kartu ucapan doa mabrur dan nama jamaah?',
      a: 'Sangat bisa. Setiap souvenir dilengkapi kartu ucapan doa kepulangan mabrur bertuliskan nama lengkap jamaah dan keluarga penyelenggara tasyakuran.'
    },
    {
      q: 'Berapa minimum order souvenir haji dan umrah?',
      a: 'Mulai dari 30 pcs, cocok untuk pengajian keluarga intim di rumah maupun tasyakuran akbar bersama rombongan kloter jamaah.'
    }
  ];
} else if (category?.slug?.includes('perusahaan') || category?.slug?.includes('kantor') || category?.slug?.includes('bumn') || category?.slug?.includes('sertijab')) {
  categoryFaqs = [
    {
      q: 'Apakah Sekata menyediakan invoice, faktur pajak, dan kelengkapan administrasi kantor?',
      a: 'Ya, Sekata adalah entitas resmi yang siap menyediakan surat penawaran, invoice bertanda tangan, kwitansi resmi, dan kelengkapan administrasi pengadaan instansi BUMN maupun korporat swasta.'
    },
    {
      q: 'Metode branding apa saja yang dapat diaplikasikan pada souvenir perusahaan?',
      a: 'Kami menyediakan deboss presisi pada material kulit sintetis, grafir laser permanen pada tumbler stainless, sablon presisi pada tas kanvas, dan hot-stamping foil emas/silver pada hardbox magnetik.'
    },
    {
      q: 'Apakah isi gift set korporat bisa disesuaikan dengan pagu anggaran divisi?',
      a: 'Bisa banget. Kamu cukup menginformasikan besaran pagu anggaran per pax kepada Ayu, dan tim desainer kami akan meracik kombinasi item terbaik yang elegan dan tetap efisien.'
    },
    {
      q: 'Bisa kirim ke kantor cabang di berbagai kota?',
      a: 'Tentu bisa. Kami melayani pengiriman terjadwal dan terkoordinasi ke kantor pusat maupun cabang di berbagai kota di Indonesia dengan packing kayu standar kargo.'
    }
  ];
}

// Penentuan gambar banner header dari 4 foto rasio 3:1 (2172x724) sesuai tema halaman
let heroImage = '/images/hero-mawar-gading.png';

if (isHampersLebaran || activeSlug?.includes('lebaran')) {
  heroImage = '/images/hero-mawar-pastel.png'; // Mawar pastel & dedaunan segar
} else if (isWedding || activeSlug?.includes('wedding')) {
  heroImage = '/images/hero-mawar-gading.png'; // Mawar taman gading dalam cahaya lembut
} else if (isHajiUmrah || activeSlug?.includes('haji') || activeSlug?.includes('umrah') || page === 'gift') {
  heroImage = '/images/hero-tulip-gading.png'; // Hamparan tulip lembut di kain gading
} else if (
  page === 'souvenir' ||
  page === 'sekata' ||
  activeSlug?.includes('perusahaan') ||
  activeSlug?.includes('bumn') ||
  activeSlug?.includes('kantor') ||
  activeSlug?.includes('sertijab') ||
  activeSlug?.includes('premium') ||
  activeSlug?.includes('tambang') ||
  activeSlug?.includes('gathering') ||
  activeSlug?.includes('seminar') ||
  activeSlug?.includes('rapat')
) {
  heroImage = '/images/hero-mawar-burgundi.png'; // Rangkaian mawar burgundi dalam cahaya lembut
} else if (page === 'hampers' || activeSlug?.includes('hampers') || page === 'temukan-solusi' || page === 'blog') {
  heroImage = '/images/hero-mawar-pastel.png'; // Mawar pastel & dedaunan segar
} else if (page === 'kontak') {
  heroImage = '/images/hero-mawar-gading.png';
} else {
  heroImage = '/images/hero-tulip-gading.png';
}
---

<Layout
  title={(category?.name || ({ gift: 'Gift & Hampers Custom', hampers: 'Hampers Custom', souvenir: 'Souvenir Custom', sekata: 'Tentang Sekata', kontak: 'Kontak Sekata', 'temukan-solusi': 'Temukan Solusi — Inspirasi Souvenir & Hampers', blog: 'Temukan Solusi — Inspirasi Souvenir & Hampers' } as any)[page!] || title) + ' | Sekata Malang'}
  description={desc}
  schema={catalogSchema}
>
  <!-- HERO SECTION DENGAN GOOGLE RATING & TOMBOL AKSI CEPAT MENU GIFT -->
  <section class="page-hero" style={`--page-hero-bg: url('${heroImage}');`}>
    <div class="breadcrumbs">
      <a href="/">Beranda</a> / {category ? <><a href="/gift/">Gift</a> / </> : ''}{category?.name || (page === 'blog' || page === 'temukan-solusi' ? 'Temukan Solusi' : titles[page!])}
    </div>
    <span class="eyebrow">{page === 'blog' || page === 'temukan-solusi' ? 'THE SEKATA JOURNAL' : 'THE SEKATA COLLECTION'}</span>
    <h1>{page === 'blog' || page === 'temukan-solusi' ? 'Inspirasi untuk momen berarti.' : title}</h1>
    <p>{page === 'blog' || page === 'temukan-solusi' ? 'Panduan memilih souvenir pernikahan, kurasi hampers personal, dan inspirasi cinderamata untuk setiap perayaan berharga.' : desc}</p>

    {isCatalog && (
      <>
        <!-- RATING GOOGLE SNIPPET BADGE -->
        <div class="product-rating-badge" style="margin-top: 14px;">
          <div class="star-rating" aria-label="Rating 4.9 dari 5 bintang">
            <span class="stars">★★★★★</span>
            <span class="rating-score">4.9 / 5.0</span>
          </div>
          <span class="rating-dot">·</span>
          <span class="rating-reviews">128 Ulasan Terverifikasi</span>
          <span class="rating-dot">·</span>
          <span class="rating-sold">2.500+ Paket Terkirim</span>
        </div>

        <!-- TOMBOL AKSI CEPAT: LIHAT PAKET, PERBANDINGAN, CARA PESAN, FAQ -->
        <div class="gift-action-nav" role="navigation" aria-label="Aksi Cepat Menu Gift">
          <a href="#productGrid" class="gift-action-btn">
            Lihat Paket <Icon name="chevron" size={12} />
          </a>
          <a href="#perbandingan-paket" class="gift-action-btn">
            Perbandingan Paket <Icon name="chevron" size={12} />
          </a>
          <a href="#cara-pesan-gift" class="gift-action-btn">
            Cara Pesan <Icon name="chevron" size={12} />
          </a>
          <a href="#faq-kategori" class="gift-action-btn">
            FAQ & Tanya Jawab <Icon name="chevron" size={12} />
          </a>
        </div>
      </>
    )}
  </section>

  {isCatalog && (
    <!-- STRIP KELEBIHAN: CUSTOM LOGO & DESAIN, PAKET FLEKSIBEL, TARGET KOTA MALANG, BATU, KEPANJEN & JATIM -->
    <div class="gift-usp-strip-wrap">
      <div class="gift-usp-grid">
        <div class="gift-usp-box">
          <div class="usp-icon-circle"><Icon name="check" size={18} /></div>
          <div>
            <h4>Custom Logo & Desain</h4>
            <p>Bebas kustomisasi inisial monogram, deboss kulit, foil emas, dan kartu ucapan terima kasih.</p>
          </div>
        </div>
        <div class="gift-usp-box">
          <div class="usp-icon-circle"><Icon name="check" size={18} /></div>
          <div>
            <h4>Paket Fleksibel</h4>
            <p>Pilihan isi hampers, kombinasi souvenir, serta anggaran dapat disesuaikan kebutuhan acaramu.</p>
          </div>
        </div>
        <div class="gift-usp-box highlight-city-box">
          <div class="usp-icon-circle"><Icon name="check" size={18} /></div>
          <div>
            <h4>Target Pengiriman Cepat</h4>
            <p>Malang • Batu • Kepanjen • Sekitar Jawa Timur (by request) & Seluruh Indonesia bergaransi aman.</p>
          </div>
        </div>
      </div>
    </div>
  )}

  {isCatalog ? (
    <section class="section" id="catalog-container">
      <div class="catalog-wrapper">
        <!-- SIDEBAR KIRI (Eksplore Sesuai Referensi Dekayu) -->
        <aside class="catalog-sidebar" aria-label="Kategori dan Filter Gift">
          <h3 class="sidebar-title">Eksplore</h3>

          <div class="sidebar-group">
            <span class="sidebar-group-title">Koleksi Utama</span>
            <ul class="sidebar-links">
              <li><a href="/gift/" class={page === 'gift' ? 'active' : ''}>Semua Koleksi</a></li>
              <li><a href="/souvenir-wedding/" class={page === 'souvenir-wedding' || page === 'gift/souvenir-wedding' ? 'active' : ''}>Wedding Souvenir</a></li>
              <li><a href="/souvenir-haji-umrah/" class={page === 'souvenir-haji-umrah' || page === 'gift/souvenir-haji-umrah' ? 'active' : ''}>Souvenir Haji & Umrah</a></li>
              <li><a href="/hampers/" class={page === 'hampers' ? 'active' : ''}>Hampers & Gift Box</a></li>
              <li><a href="/souvenir-perusahaan/" class={page === 'souvenir-perusahaan' || page === 'gift/souvenir-perusahaan' ? 'active' : ''}>Corporate Souvenir</a></li>
            </ul>
          </div>

          <div class="sidebar-group">
            <span class="sidebar-group-title">Hampers Momen</span>
            <ul class="sidebar-links">
              <li><a href="/hampers-lebaran/" class={page === 'hampers-lebaran' || page === 'gift/hampers-lebaran' ? 'active' : ''}>Hampers Lebaran</a></li>
              <li><a href="/hampers-ulang-tahun/" class={page === 'hampers-ulang-tahun' || page === 'gift/hampers-ulang-tahun' ? 'active' : ''}>Hampers Ulang Tahun</a></li>
              <li><a href="/hampers-wisuda/" class={page === 'hampers-wisuda' || page === 'gift/hampers-wisuda' ? 'active' : ''}>Hampers Wisuda</a></li>
              <li><a href="/hampers-anak/" class={page === 'hampers-anak' || page === 'gift/hampers-anak' ? 'active' : ''}>Hampers Anak</a></li>
              <li><a href="/hampers-wedding/" class={page === 'hampers-wedding' || page === 'gift/hampers-wedding' ? 'active' : ''}>Hampers Wedding</a></li>
            </ul>
          </div>

          <div class="sidebar-group">
            <span class="sidebar-group-title">Souvenir Acara</span>
            <ul class="sidebar-links">
              <li><a href="/souvenir-sertijab/" class={page === 'souvenir-sertijab' || page === 'gift/souvenir-sertijab' ? 'active' : ''}>Sertijab & VIP</a></li>
              <li><a href="/souvenir-bumn/" class={page === 'souvenir-bumn' || page === 'gift/souvenir-bumn' ? 'active' : ''}>BUMN & Kantor</a></li>
              <li><a href="/souvenir-gathering/" class={page === 'souvenir-gathering' || page === 'gift/souvenir-gathering' ? 'active' : ''}>Gathering</a></li>
              <li><a href="/souvenir-seminar-workshop/" class={page === 'souvenir-seminar-workshop' || page === 'gift/souvenir-seminar-workshop' ? 'active' : ''}>Seminar & Workshop</a></li>
            </ul>
          </div>

          <div class="sidebar-consult-box">
            <h4>Butuh Rekomendasi?</h4>
            <p>Konsultasikan konsep, jumlah, dan budget souvenir acaramu bersama Kak Ayu.</p>
            <a href={wa} class="button" style="padding:8px 14px;font-size:12px;display:inline-flex;" target="_blank" rel="noopener noreferrer">
              Chat Ayu di WhatsApp <Icon name="chat" size={14} />
            </a>
          </div>
        </aside>

        <!-- KONTEN UTAMA PRODUK -->
        <main class="catalog-main" id="catalog-main">
          <div class="catalog-status-bar">
