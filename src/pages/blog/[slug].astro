export function getStaticPaths() {
  const paths: any[] = articles.map((a) => ({ params: { slug: a.slug }, props: { a } }));
  const legacyRedirects = [
    { oldSlug: 'souvenir-wedding', newSlug: 'panduan-memilih-souvenir-pernikahan' },
    { oldSlug: 'panduan-memilih-souvenir-wedding', newSlug: 'panduan-memilih-souvenir-pernikahan' },
    { oldSlug: 'souvenir-wedding-aesthetic', newSlug: 'desain-souvenir-wedding-modern' },
    { oldSlug: 'souvenir-wedding-earth-tone', newSlug: 'warna-souvenir-wedding-earth-tone' },
    { oldSlug: 'souvenir-wedding-emboss-vs-printing', newSlug: 'emboss-vs-printing-souvenir-wedding' },
    { oldSlug: 'hampers-lebaran', newSlug: 'panduan-memilih-hampers-lebaran' }
  ];
  legacyRedirects.forEach(({ oldSlug, newSlug }) => {
    const article = articles.find((art) => art.slug === newSlug);
    if (article) {
      paths.push({ params: { slug: oldSlug }, props: { a: article, isRedirect: true, targetSlug: newSlug } });
    }
  });
  return paths;
}

