    ['ketahanan-pemakaian', 'Ketahanan Hasil Personalisasi dalam Pemakaian Sehari-hari'],
    ['struktur-biaya', 'Memahami Struktur Pembentukan Biaya Produksi'],
    ['matriks-panduan-desain', 'Matriks Panduan Pemilihan Berdasarkan Karakter Desain'],
    ['kesalahan-teknis', 'Kesalahan Teknis yang Sering Terjadi pada Tahap Produksi'],
    ['faq', 'Pertanyaan Seputar Teknik Emboss dan Printing Souvenir'],
    ['kesimpulan', 'Kesimpulan Praktis']
  ],
  'panduan-memilih-souvenir-pernikahan': [
    ['makna', 'Souvenir Pernikahan sebagai Tanda Apresiasi dan Cerita Bersama'],
    ['anggaran', 'Rencanakan Anggaran dan Rumus Perhitungan Biaya Total'],
    ['klasifikasi-fungsi', 'Klasifikasi Souvenir Berdasarkan Fungsi Pakai Sehari-hari'],
    ['skala-dan-logistik', 'Menyesuaikan Pilihan dengan Skala dan Logistik Acara'],
    ['custom-vs-standar', 'Perbandingan Souvenir Custom Penuh dan Produk Standar'],
    ['karakter-material', 'Memahami Karakter Material Dasar Souvenir'],
    ['konsep', 'Satukan Hadiah dengan Konsep Pernikahan'],
    ['alur-pemesanan', 'Alur Pemesanan Souvenir dari Awal hingga Pengiriman'],
    ['kesalahan-pengadaan', 'Kesalahan Manajemen Pengadaan yang Perlu Dihindari'],
    ['skenario-souvenir-wedding', 'Matriks Skenario Kebutuhan Souvenir Wedding'],
    ['faq', 'Pertanyaan Seputar Pemilihan Souvenir Pernikahan'],
    ['kesimpulan', 'Kesimpulan Praktis']
  ],
  'souvenir-pernikahan-fungsional': [
    ['skor-pakai', 'Cara Menilai Souvenir Fungsional dengan Skor Pakai'],
    ['rincian-budget', 'Rincian Budget 50rb–100rb dan Komponen yang Termasuk'],
    ['ide-souvenir', '10 Ide Souvenir Pernikahan Fungsional'],
    ['penghuni-laci', '3 Jenis Souvenir yang Sering Jadi Penghuni Laci'],
    ['memilih-berdasarkan-tamu', 'Cara Memilih Souvenir Berdasarkan Karakter Tamu'],
    ['faq', 'Pertanyaan yang Sering Diajukan tentang Souvenir Fungsional'],
    ['kesimpulan', 'Siap Memilih Souvenir yang Benar-benar Dipakai?']
  ],
  'hampers-yang-lebih-personal': [
    ['penerima', 'Mulai dari orang yang akan menerimanya.'],
    ['isi', 'Kurasi isi yang saling melengkapi dan bernilai guna.'],
    ['detail', 'Siapkan detail sebelum konsultasi.'],
    ['langkah', 'Sepakati isi, tampilan, dan jadwal pengiriman.']
  ],
  'persiapan-souvenir-acara': [
    ['tujuan', 'Tetapkan tujuan pemberian dan profil penerima.'],
    ['estimasi', 'Tentukan jumlah kebutuhan dan cadangan acara.'],
    ['anggaran', 'Alokasikan batas belanja yang nyaman per paket.'],
    ['timeline', 'Perhitungkan tenggat waktu produksi dan pengiriman.'],
    ['branding', 'Siapkan file logo, inisial monogram, dan kartu ucapan.']
  ]
};

const toc = tocMap[a.slug] || [];
const relatedArticles = articles.filter((x) => x.slug !== a.slug);

const schema = articleSchemas[a.slug] || {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: a.title,
  description: a.excerpt,
  image: 'https://sekata.web.id/images/' + a.image,
  datePublished: '2026-11-07T09:00:00+07:00',
  dateModified: '2026-11-09T09:00:00+07:00',
  author: {
    '@type': 'Person',
    name: 'M. Maulana Ishaq',
    url: 'https://sekata.web.id/penulis/m-maulana-ishaq/'
  },
  publisher: {
    '@id': 'https://sekata.web.id/#organization'
  },
  mainEntityOfPage: 'https://sekata.web.id/blog/' + a.slug + '/'
};

const displayTitle = a.title.replace(/:\s*/g, ' ');
const displayMetaTitle = (a as any).metaTitle ? (a as any).metaTitle.replace(/:\s*/g, ' ') : displayTitle;
const pageTitle = (a as any).metaTitle ? `${displayMetaTitle} | Sekata Malang` : `${displayTitle} — Temukan Solusi | Sekata Malang`;
const authorDisplay = (a as any).author || 'M. Maulana Ishaq';
const readTime = (a as any).readTime || '6';
---

<Layout title={pageTitle} description={a.excerpt} schema={schema}>
  <!-- HEADER HERO DENGAN BANNER MAWAR PASTEL -->
  <header class="page-hero" style="--page-hero-bg: url('/images/hero-mawar-pastel.png');">
    <div class="breadcrumbs">
      <a href="/">Beranda</a> / <a href="/blog/">Temukan Solusi</a> / {a.category}
    </div>
    <span class="eyebrow">{a.category}</span>
    <h1>{displayTitle}</h1>
    <p>{a.excerpt}</p>
    <div class="article-meta">
      {isWeddingCluster ? (
        <span>Ditulis oleh {authorDisplay} · Direview oleh {(a as any).reviewedBy || 'Editor Konten'} · {(a as any).dateModified || '2026-11-10'} · {readTime} menit baca</span>
      ) : (
        <span>Ditulis oleh <a href="/penulis/m-maulana-ishaq/">M. Maulana Ishaq</a> · 7 November 2026 · {readTime} menit baca</span>
      )}
    </div>
  </header>

  <!-- KONTEN ARTIKEL & SIDEBAR -->
  <div class="article-layout">
    <article class="prose">
      <img
        class="article-cover"
        src={'/images/' + a.image}
        alt={'Ilustrasi ' + a.title}
        width="1000"
        height="650"
      />
      <p style="font-size:13px;color:var(--muted);margin-top:8px">Foto ilustrasi inspirasi hadiah Sekata.</p>

      <!-- DESKRIPSI PERTAMA -->
      {a.slug === 'panduan-lengkap-souvenir-pernikahan' ? (
        <p class="first-desc-paragraph">
          Souvenir pernikahan adalah cinderamata yang diberikan kepada tamu undangan sebagai bentuk apresiasi atas kehadiran dan doa restu mereka. Pilihan souvenir yang tepat memadukan fungsi, desain yang berkesan, dan kesesuaian anggaran.
        </p>
      ) : a.slug === 'souvenir-pernikahan-yang-berguna' ? (
        <p class="first-desc-paragraph">
          Souvenir pernikahan yang berguna adalah cinderamata yang dapat dimanfaatkan tamu dalam aktivitas sehari-hari, seperti tumbler, pouch, notebook, card holder, dan produk perawatan diri yang sesuai kebutuhan penerima.
        </p>
      ) : a.slug === 'budget-souvenir-pernikahan' ? (
        <p class="first-desc-paragraph">
          Budget souvenir pernikahan merupakan perencanaan biaya untuk membeli produk, kemasan, personalisasi, dan distribusi cinderamata bagi tamu undangan. Perhitungan yang tepat dimulai dari jumlah penerima, batas harga per produk, dan biaya tambahan agar pengeluaran tetap terkendali.
        </p>
      ) : a.slug === 'tips-memilih-vendor-souvenir-pernikahan' ? (
        <p class="first-desc-paragraph">
          Vendor souvenir pernikahan adalah penyedia produk cinderamata yang membantu pasangan pengantin memenuhi kebutuhan souvenir berdasarkan jumlah, anggaran, desain, dan waktu acara. Vendor yang tepat memiliki spesifikasi produk jelas, menyediakan sampel, serta mampu menjelaskan proses produksi dan pengiriman.
        </p>
      ) : a.slug === 'panduan-memilih-hampers-lebaran' || a.slug === 'hampers-lebaran' ? (
        <p class="first-desc-paragraph">
          Hampers lebaran adalah paket hadiah berisi makanan atau barang pilihan yang dikirim saat Idulfitri untuk keluarga, kolega, dan klien sebagai simbol silaturahmi dan apresiasi.
        </p>
      ) : a.slug === 'isi-hampers-lebaran' ? (
        <p class="first-desc-paragraph">
          Isi hampers lebaran yang umum meliputi kue kering, makanan ringan, minuman, kurma, dan barang gift seperti mug, keramik, atau totebag, disesuaikan dengan penerima dan anggaran.
        </p>
      ) : a.slug === 'hampers-lebaran-perusahaan' ? (
        <p class="first-desc-paragraph">
          Hampers lebaran perusahaan adalah paket Idulfitri yang dikirim bisnis kepada karyawan, klien, dan mitra, biasanya dilengkapi logo, kartu ucapan, dan kemasan bermerek.
        </p>
      ) : a.slug === 'hampers-lebaran-malang' ? (
        <p class="first-desc-paragraph">
          Hampers Lebaran Malang tersedia dalam pilihan kue kering, makanan khas, perlengkapan ibadah, dan hadiah custom yang dapat disesuaikan dengan penerima serta anggaran.
        </p>
      ) : a.slug === 'pilihan-hampers-lebaran-sesuai-anggaran' ? (
        <p class="first-desc-paragraph">
          Pilihan hampers Lebaran sesuai anggaran dimulai dari menentukan penerima, memprioritaskan kualitas isi, lalu memilih kemasan yang aman tanpa menambah biaya tidak perlu.
        </p>
      ) : a.slug === 'hampers-lebaran-perusahaan-malang' ? (
        <p class="first-desc-paragraph">
          Hampers Lebaran perusahaan Malang sebaiknya dipilih berdasarkan hubungan penerima, kualitas isi, desain branding yang proporsional, serta kemampuan vendor menangani pesanan massal.
        </p>
      ) : a.slug === 'pengiriman-hampers-lebaran-malang-raya' ? (
        <p class="first-desc-paragraph">
          Pengiriman hampers Lebaran Malang Raya perlu direncanakan berdasarkan jenis isi, jarak alamat, jadwal penerima, dan perlindungan kemasan agar hadiah tiba layak.
        </p>
      ) : a.slug === 'panduan-memilih-souvenir-pernikahan' || a.slug === 'panduan-memilih-souvenir-wedding' || a.slug === 'souvenir-wedding' ? (
        <p class="first-desc-paragraph">
          Souvenir pernikahan yang berkesan adalah hadiah yang sesuai dengan penerima, konsep acara, dan kemampuan anggaran pasangan. Mulailah dari jumlah kebutuhan dan kegunaan barang, kemudian pilih material serta kemasan yang mendukung cerita pernikahanmu.
        </p>
      ) : a.slug === 'souvenir-pernikahan-fungsional' ? (
        <p class="first-desc-paragraph">
          Pernah pulang dari pernikahan membawa souvenir yang cantik, lalu tiga bulan kemudian menemukannya masih utuh di dasar laci? Berikut 10 ide souvenir pernikahan fungsional budget 50–100 ribu dengan Skor Pakai agar benar-benar dipakai tamu.
        </p>
      ) : a.slug === 'desain-souvenir-wedding-modern' || a.slug === 'souvenir-wedding-aesthetic' ? (
        <p class="first-desc-paragraph">
          Desain souvenir wedding modern bertumpu pada pengendalian proporsi visual, pemilihan tipografi yang bersih, pengaturan ruang kosong, keselarasan komponen kecil, serta kerapian pengerjaan fisik dibandingkan penggunaan banyak hiasan.
        </p>
      ) : a.slug === 'warna-souvenir-wedding-earth-tone' || a.slug === 'souvenir-wedding-earth-tone' ? (
        <p class="first-desc-paragraph">
          Warna souvenir wedding earth tone mengacu pada spektrum warna turunan alam seperti sage green, cream, beige, taupe, olive, dan terracotta yang dipadukan berdasarkan kesamaan suhu warna (undertone) untuk menciptakan suasana pernikahan yang hangat dan menyatu dengan dekorasi.
        </p>
      ) : a.slug === 'emboss-vs-printing-souvenir-wedding' || a.slug === 'souvenir-wedding-emboss-vs-printing' ? (
        <p class="first-desc-paragraph">
          Emboss dan printing pada souvenir wedding custom merupakan dua pendekatan personalisasi yang berbeda secara mendasar, di mana emboss membentuk tekstur fisik timbul atau tertekan pada permukaan material, sedangkan printing mengaplikasikan pigmen tinta berwarna melalui proses transfer.
        </p>

      ) : personal ? (
        <p class="first-desc-paragraph">
          Mulai dari penerima, pilih isi, lalu satukan cerita lewat kemasan. Hadiah yang terasa personal dimulai dari memahami kebutuhan, lalu memilih detail yang relevan. Dengan brief yang jelas, percakapan dengan vendor akan lebih mudah dan pilihan produk menjadi lebih terarah.
        </p>
      ) : (
        <p class="first-desc-paragraph">
          Sebelum memesan souvenir untuk acara kantor, syukuran keluarga, atau cinderamata pernikahan, menyiapkan brief sederhana akan menghemat banyak waktu. Informasi yang jelas sejak awal membantu vendor memberikan rekomendasi produk dan estimasi harga yang paling tepat.
        </p>
      )}

      <!-- DAFTAR ISI DI BAWAH DESKRIPSI PERTAMA (SESUAI PERMINTAAN USER) -->
      {toc.length > 0 && (
        <div class="inline-toc-box">
          <div class="inline-toc-head">
            <span class="eyebrow">PANDUAN BACA</span>
            <h3>Daftar Isi Artikel</h3>
          </div>
          <ol class="inline-toc-list">
            {toc.map(([id, itemTitle]) => (
              <li>
                <a href={'#' + id}>{itemTitle}</a>
              </li>
            ))}
          </ol>
        </div>
      )}

      <!-- ISI KONTEN LENGKAP -->
      {a.slug === 'panduan-lengkap-souvenir-pernikahan' ? (
        <ArticlePanduanLengkapSouvenirPernikahan />
      ) : a.slug === 'souvenir-pernikahan-yang-berguna' ? (
        <ArticleSouvenirPernikahanYangBerguna />
      ) : a.slug === 'budget-souvenir-pernikahan' ? (
        <ArticleBudgetSouvenirPernikahan />
      ) : a.slug === 'tips-memilih-vendor-souvenir-pernikahan' ? (
        <ArticleTipsMemilihVendorSouvenirPernikahan />
      ) : a.slug === 'panduan-memilih-hampers-lebaran' || a.slug === 'hampers-lebaran' ? (
        <ArticleHampersLebaran />
      ) : a.slug === 'isi-hampers-lebaran' ? (
        <ArticleIsiHampersLebaran />
      ) : a.slug === 'hampers-lebaran-perusahaan' ? (
        <ArticleHampersLebaranPerusahaan />
      ) : a.slug === 'hampers-lebaran-malang' ? (
        <ArticleHampersLebaranMalang />
      ) : a.slug === 'pilihan-hampers-lebaran-sesuai-anggaran' ? (
        <ArticlePilihanHampersLebaranSesuaiAnggaran />
      ) : a.slug === 'hampers-lebaran-perusahaan-malang' ? (
        <ArticleHampersLebaranPerusahaanMalang />
      ) : a.slug === 'pengiriman-hampers-lebaran-malang-raya' ? (
        <ArticlePengirimanHampersLebaranMalangRaya />
      ) : a.slug === 'panduan-memilih-souvenir-pernikahan' || a.slug === 'panduan-memilih-souvenir-wedding' || a.slug === 'souvenir-wedding' ? (
        <ArticlePanduanSouvenirPernikahan />
      ) : a.slug === 'souvenir-pernikahan-fungsional' ? (
        <ArticleSouvenirPernikahanFungsional />
      ) : a.slug === 'desain-souvenir-wedding-modern' || a.slug === 'souvenir-wedding-aesthetic' ? (
        <ArticleSouvenirWeddingAesthetic />
      ) : a.slug === 'warna-souvenir-wedding-earth-tone' || a.slug === 'souvenir-wedding-earth-tone' ? (
        <ArticleSouvenirWeddingEarthTone />
      ) : a.slug === 'emboss-vs-printing-souvenir-wedding' || a.slug === 'souvenir-wedding-emboss-vs-printing' ? (
        <ArticleSouvenirWeddingEmbossVsPrinting />
      ) : personal ? (
        <>
          <h2 id="penerima">Mulai dari orang yang akan menerimanya.</h2>
          <p>
            Pertimbangkan hubunganmu dengan penerima, kebiasaan sehari-hari, dan konteks pemberian. Untuk perayaan personal, nama atau pesan singkat dapat menghadirkan kedekatan. Untuk acara perusahaan, warna dan identitas acara bisa menjadi titik awal.
          </p>

          <h2 id="isi">Kurasi isi yang saling melengkapi dan bernilai guna.</h2>
          <p>
            Hampers yang berkesan bukan tentang banyaknya isi, melainkan keharmonisan antar barang di dalamnya. Kombinasikan produk yang dapat langsung dinikmati (seperti teh artisan atau cookies) dengan cinderamata tahan lama (seperti mug keramik, pouch kulit, atau reed diffuser).
          </p>
          <p>
            Hindari memasukkan barang pelengkap yang fungsinya tidak jelas hanya demi mengisi ruang kosong. Kemasan yang dirancang pas dengan ukuran isi justru menunjukkan kerapian dan niat tulus pemberi.
          </p>

          <h2 id="detail">Siapkan detail sebelum konsultasi.</h2>
          <ul>
            <li>Jenis acara dan pesan emosional yang ingin disampaikan.</li>
            <li>Jumlah penerima dan pilihan isi yang diinginkan.</li>
            <li>Kisaran anggaran termasuk kemasan dan pengiriman.</li>
            <li>Tanggal kebutuhan serta kota tujuan penerima (Malang, Batu, Kepanjen, atau luar kota).</li>
            <li>Referensi warna kemasan, nama inisial, logo instansi, dan kartu ucapan.</li>
          </ul>

          <h2 id="langkah">Sepakati isi, tampilan, dan jadwal pengiriman.</h2>
          <p>
            Minta konfirmasi tertulis mengenai spesifikasi, jumlah, personalisasi, pembayaran, dan jadwal. Periksa kembali ejaan nama serta desain mockup sebelum memberi persetujuan produksi massal.
          </p>
          <p>
            Untuk souvenir atau hampers yang sesuai kebutuhanmu, diskusikan pilihan aktual bersama admin Sekata di WhatsApp.
          </p>
        </>
      ) : (
        <>
          <h2 id="tujuan">Tetapkan tujuan pemberian dan profil penerima.</h2>
          <p>
            Langkah pertama yang paling menentukan adalah mengetahui kepada siapa hadiah ini ditujukan. Cinderamata untuk mitra korporat membutuhkan pendekatan berbeda dibanding souvenir tasyakuran keluarga, wisuda, atau pernikahan.
          </p>

          <h2 id="estimasi">Tentukan jumlah kebutuhan dan cadangan acara.</h2>
          <p>
            Hitung daftar penerima utama, lalu tambahkan cadangan berkisar 5–10% untuk mengantisipasi kehadiran tamu tambahan tak terduga atau kebutuhan dokumentasi arsip panitia.
          </p>

          <h2 id="anggaran">Alokasikan batas belanja yang nyaman per paket.</h2>
          <p>
            Tentukan plafon anggaran per orang atau total pagu dana acara. Sampaikan kisaran ini kepada admin agar rekomendasi material, kemasan mika vs hardbox, dan opsi personalisasi disesuaikan sejak awal tanpa melampaui rencana anggaranmu.
          </p>

          <h2 id="timeline">Perhitungkan tenggat waktu produksi dan pengiriman.</h2>
          <p>
            Produksi souvenir custom berkualitas membutuhkan waktu untuk pembuatan proof sample, approval desain, pengerjaan fisik, quality check, dan durasi pengiriman ekspedisi kargo menuju kota tujuanmu.
          </p>

          <h2 id="branding">Siapkan file logo, inisial monogram, dan kartu ucapan.</h2>
          <p>
            Kumpulkan aset visual seperti file vektor logo instansi, ejaan nama kedua mempelai, tanggal acara, serta kalimat ucapan terima kasih yang ingin dicetak pada thank you card atau hangtag.
          </p>
        </>
      )}

      <!-- KOTAK KONSULTASI AKHIR ARTIKEL -->
      <div class="detail-list" style="margin-top: 36px;">
        <p>
          Butuh rekomendasi untuk acaramu?{' '}
          <a href={wa + '?text=' + encodeURIComponent('Halo Kak Ayu, saya selesai membaca artikel ' + a.title + ' dan ingin konsultasi pilihan souvenir.')} target="_blank" rel="noopener noreferrer">
            Konsultasikan konsep dan penawaran bersama Ayu.
          </a>
        </p>
      </div>

      <p style="font-size: 13.5px; color: var(--muted); margin-top: 14px;">
        {isWeddingCluster ? (
          <>Penulis: <strong>{authorDisplay}</strong> · Direview oleh: <strong>{(a as any).reviewedBy || 'Editor Konten'}</strong> · Terakhir diperbarui: {(a as any).dateModified || '2026-11-10'}</>
        ) : (
          <>Penulis: <a href="/penulis/m-maulana-ishaq/">M. Maulana Ishaq</a></>
        )}
      </p>
    </article>

    <!-- SIDEBAR DENGAN ARTIKEL TERKAIT -->
    <aside class="article-sidebar" aria-label="Sidebar Rekomendasi">
      <div class="sidebar-block sidebar-related-block">
        <span class="eyebrow">REKOMENDASI BACA</span>
        <h3 class="sidebar-title">Artikel Terkait</h3>
        <div class="sidebar-related-list">
          {relatedArticles.map((item) => (
            <a href={'/blog/' + item.slug + '/'} class="sidebar-related-item">
              <div class="related-thumb-wrap">
                <img
                  src={'/images/' + item.image}
                  alt={'Thumbnail ' + item.title}
                  width="280"
                  height="160"
                  loading="lazy"
                  class="related-thumb"
                />
              </div>
              <div class="related-info">
                <span class="related-badge">{item.category}</span>
                <h4 class="related-title">{item.title.replace(/:\s*/g, ' ')}</h4>
                <span class="related-read-more">
                  Baca artikel <Icon name="chevron" size={12} />
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- KONSULTASI VIA WHATSAPP DENGAN AYU -->
      <div class="sidebar-block sidebar-consult-card">
        <span class="consult-tag">KONSULTASI GRATIS</span>
        <h3>Punya Cerita Sendiri?</h3>
        <p>
          Bicarakan kebutuhan souvenir, hampers, dan suasana yang ingin kamu hadirkan bersama Ayu di WhatsApp.
        </p>
        <a
          href={wa + '?text=' + encodeURIComponent('Halo Kak Ayu, saya membaca artikel di blog Sekata dan ingin konsultasi persiapan souvenir.')}
          class="button"
          style="width: 100%; justify-content: center;"
          target="_blank"
          rel="noopener noreferrer"
        >
          Chat Ayu di WhatsApp <Icon name="chat" size={15} />
        </a>
      </div>
    </aside>
  </div>
</Layout>
