---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { wa, map } from '../data/site';

const pageTitle = 'Tentang Kami Sekata Gift Hampers dan Souvenir Custom Malang | Sekata';
const pageDesc = 'Kenali Sekata, layanan gift, hampers, dan souvenir custom dari Malang. Pelajari pilihan personalisasi, proses pemesanan, dan konsultasi bersama Ayu.';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': 'https://sekata.web.id/tentang-kami/#webpage',
      'url': 'https://sekata.web.id/tentang-kami/',
      'name': 'Tentang Kami Sekata Gift Hampers dan Souvenir Custom Malang',
      'description': pageDesc,
      'inLanguage': 'id-ID',
      'isPartOf': {
        '@type': 'WebSite',
        '@id': 'https://sekata.web.id/#website',
        'name': 'Sekata',
        'url': 'https://sekata.web.id'
      },
      'breadcrumb': {
        '@id': 'https://sekata.web.id/tentang-kami/#breadcrumb'
      },
      'mainEntity': {
        '@id': 'https://sekata.web.id/#organization'
      }
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://sekata.web.id/tentang-kami/#breadcrumb',
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': 'Beranda',
          'item': 'https://sekata.web.id/'
        },
        {
          '@type': 'ListItem',
          'position': 2,
          'name': 'Tentang Kami',
          'item': 'https://sekata.web.id/tentang-kami/'
        }
      ]
    },
    {
      '@type': 'Organization',
      '@id': 'https://sekata.web.id/#organization',
      'name': 'Sekata',
      'url': 'https://sekata.web.id',
      'telephone': '+6282131087971',
      'logo': {
        '@type': 'ImageObject',
        'url': 'https://sekata.web.id/images/logo.webp'
      },
      'image': 'https://sekata.web.id/images/logo.webp',
      'address': {
        '@type': 'PostalAddress',
        'streetAddress': 'Jalan Bandara Palmerah, Cemorokandang',
        'addressLocality': 'Malang',
        'addressRegion': 'Jawa Timur',
        'postalCode': '65138',
        'addressCountry': 'ID'
      },
      'geo': {
        '@type': 'GeoCoordinates',
        'latitude': -7.9907544,
        'longitude': 112.6804383
      },
      'hasMap': map
    }
  ]
};
---

<Layout title={pageTitle} description={pageDesc} schema={schema} hideDefaultOrgSchema={true}>
  <!-- HERO SECTION -->
  <section class="page-hero" style="--page-hero-bg: url('/images/hero-mawar-gading.png');">
    <div class="breadcrumbs">
      <a href="/">Beranda</a> / Tentang Kami
    </div>
    <span class="eyebrow">TENTANG KAMI</span>
    <h1>Tentang Sekata Gift Hampers dan Souvenir Custom dari Malang</h1>
    <p class="hero-tagline">“Kita bertemu dalam satu rasa”</p>
  </section>

  <!-- MAIN ARTICLE CONTAINER -->
  <article class="about-container">
    <!-- PENGANTAR -->
    <div class="intro-card">
      <p class="intro-text">
        Sekata melayani kebutuhan gift, hampers, dan souvenir custom dari Malang, Jawa Timur. Kami membantu pelanggan memilih isi hadiah, personalisasi, dan kemasan sesuai momen, penerima, jumlah kebutuhan, serta anggaran yang direncanakan. Kebutuhan tersebut mencakup hadiah personal, souvenir pernikahan, hingga apresiasi untuk acara dan perusahaan.
      </p>
    </div>

    <!-- 1. MENGENAL SEKATA -->
    <section class="content-section">
      <span class="section-tag">FILOSOFI KAMI</span>
      <h2>Mengenal Sekata</h2>
      <p>
        Bagi kami di Sekata, hadiah bukan sekadar barang yang dibungkus rapi lalu diserahkan. Sebuah cinderamata adalah jembatan rasa, cara nyata untuk menyampaikan terima kasih, perhatian tulus, dan penghargaan kepada orang-orang yang berarti dalam hidup atau perjalanan bisnis Anda.
      </p>
      <p>
        Sekata mengedepankan pendekatan yang hangat, komunikatif, dan fleksibel. Kami memahami bahwa setiap momen perayaan memiliki cerita dan karakter yang berbeda. Karena itu, kami tidak membatasi pelanggan pada pilihan paket yang kaku. Sebaliknya, kami membuka ruang diskusi terbuka agar setiap detail hadiah mencerminkan ketulusan pemesan.
      </p>
    </section>

    <!-- 2. PILIHAN HADIAH UNTUK BERBAGAI MOMEN -->
    <section class="content-section">
      <span class="section-tag">LAYANAN UTAMA</span>
      <h2>Pilihan Hadiah untuk Berbagai Momen</h2>
      <p>
        Untuk memenuhi berbagai skala kebutuhan perayaan, Sekata mengelompokkan layanan hadiah custom ke dalam tiga kategori utama yang terkurasi:
      </p>

      <div class="category-grid">
        <div class="category-card">
          <div class="card-icon">
            <Icon name="gift" size={28} />
          </div>
          <h3>Gift Custom</h3>
          <p>
            Koleksi hadiah personal untuk momen intim dan penuh makna, seperti ulang tahun sahabat, hari jadi pernikahan, kelulusan wisuda, hingga ucapan lekas sembuh. Pilihan isi dirancang fleksibel agar menyentuh langsung hati penerima.
          </p>
          <a href="/gift/" class="card-link">Jelajahi Gift Custom <Icon size={16} /></a>
        </div>

        <div class="category-card">
          <div class="card-icon">
            <Icon name="bag" size={28} />
          </div>
          <h3>Hampers Perayaan</h3>
          <p>
            Paket bingkisan tematik untuk perayaan hari raya seperti Idulfitri dan Natal, syukuran keluarga, parcel akhir tahun, serta apresiasi korporat. Dikemas dalam hardbox kokoh, besek bambu modern, atau reusable totebag.
          </p>
          <a href="/hampers/" class="card-link">Jelajahi Hampers <Icon size={16} /></a>
        </div>

        <div class="category-card">
          <div class="card-icon">
            <Icon name="tag" size={28} />
          </div>
          <h3>Souvenir Acara</h3>
          <p>
            Cinderamata fungsional dalam jumlah besar untuk resepsi pernikahan, seminar nasional, rapat koordinasi kantor, sertijab instansi BUMN, hingga gathering komunitas. Menyatukan nilai estetika, daya pakai tinggi, dan efisiensi biaya.
          </p>
          <a href="/souvenir/" class="card-link">Jelajahi Souvenir <Icon size={16} /></a>
        </div>
      </div>
    </section>

    <!-- 3. CARA KAMI MEMBANTU MENYIAPKAN PESANAN -->
    <section class="content-section">
      <span class="section-tag">ALUR KERJA</span>
      <h2>Cara Kami Membantu Menyiapkan Pesanan</h2>
      <p>
        Kami memastikan proses pemesanan berjalan terstruktur, transparan, dan tenang tanpa kekhawatiran keterlambatan:
      </p>

      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">1</div>
          <h3>Konsultasi Kebutuhan Awal</h3>
          <p>
            Pelanggan menginfokan jenis acara, profil penerima, perkiraan jumlah kebutuhan, tanggal acara, serta estimasi alokasi anggaran yang direncanakan.
          </p>
        </div>

        <div class="step-card">
          <div class="step-num">2</div>
          <h3>Rekomendasi Pilihan dan Estimasi</h3>
          <p>
            Ayu menyusun rekomendasi alternatif produk, material kemasan, simulasi biaya per paket, serta kepastian ketersediaan stok bahan baku.
          </p>
        </div>

        <div class="step-card">
          <div class="step-num">3</div>
          <h3>Konfirmasi Desain dan Sampel</h3>
          <p>
            Penyusunan mockup visual personalisasi (nama, monogram, atau logo) serta kartu ucapan. Untuk pesanan kuantitas besar, sampel fisik dapat disiapkan sebelum produksi massal.
          </p>
        </div>

        <div class="step-card">
          <div class="step-num">4</div>
          <h3>Produksi dan Pengiriman Tepat Waktu</h3>
          <p>
            Proses produksi dijalankan dengan kendali mutu ketat, pengemasan aman berlapis, dan jadwal pengantaran yang dipantau hingga tiba di lokasi tujuan.
          </p>
        </div>
      </div>
    </section>

    <!-- 4. DETAIL YANG DIBICARAKAN SEBELUM PEMESANAN -->
    <section class="content-section">
      <span class="section-tag">DETAIL TEKNIS</span>
      <h2>Detail yang Dibicarakan Sebelum Pemesanan</h2>
      <p>
        Ketelitian dalam detail adalah kunci hadiah yang berkesan. Dalam sesi konsultasi, Ayu akan membantu mematangkan aspek-aspek berikut:
      </p>

      <ul class="detail-list">
        <li>
          <strong>Karakter Material Produk:</strong> Memilih bahan berkualitas tinggi yang awet, ramah lingkungan, dan nyaman dipakai harian, seperti kulit sintetis premium, kanvas tebal, kayu jati perhutani, stainless steel food-grade, atau keramik stoneware.
        </li>
        <li>
          <strong>Palet Warna dan Tema Acara:</strong> Menyelaraskan warna produk dan pita dengan tema perayaan Anda, mulai dari nuansa earth tone yang hangat, pastel modern, monokrom elegan, hingga palet identitas brand perusahaan.
        </li>
        <li>
          <strong>Personalisasi Nama atau Monogram:</strong> Menentukan teknik branding yang paling pas dan proporsional, baik itu deboss tanpa warna yang mewah, hot stamping foil emas, grafir laser presisi, maupun sablon printing tajam.
        </li>
        <li>
          <strong>Kartu Ucapan dan Pesan Personal:</strong> Menyertakan pesan tulus dengan tata letak rapi, kertas berpola mewah, serta amplop berstempel lilin (wax seal) bila diinginkan.
        </li>
        <li>
          <strong>Struktur Kemasan Pelindung:</strong> Memilih tipe kemasan yang kokoh sesuai moda pengiriman, seperti hardbox magnetik, sliding box kraft ramah lingkungan, pouch serut berbahan blacu, atau besek tradisional berhias pita.
        </li>
        <li>
          <strong>Kepastian Kuantitas dan Alokasi Cadangan:</strong> Menentukan jumlah pesanan inti ditambah kuota cadangan yang proporsional untuk mengantisipasi kehadiran tamu tambahan di hari perayaan.
        </li>
        <li>
          <strong>Timeline Pengerjaan dan Jadwal Kirim:</strong> Menetapkan tenggat waktu produksi yang aman dan memperhitungkan durasi ekspedisi logistik agar barang tiba sebelum hari perayaan.
        </li>
      </ul>
    </section>

    <!-- 5. SEKATA DAN KATALOG SOUVENIR PERNIKAHAN -->
    <section class="content-section highlight-box">
      <span class="section-tag">SPESIALISASI PERNIKAHAN</span>
      <h2>Sekata dan Katalog Souvenir Pernikahan</h2>
      <p class="highlight-text">
        sekata.web.id merupakan website utama brand Sekata untuk memperkenalkan layanan gift, hampers, dan souvenir custom. Untuk kebutuhan pernikahan, Sekata juga menghadirkan souvenirpernikahan.web.id sebagai website khusus yang membahas pilihan souvenir dan panduan bagi calon pengantin.
      </p>
      <p>
        Bagi calon mempelai yang sedang merencanakan hari bahagianya, Anda dapat mengunjungi <a href="https://souvenirpernikahan.web.id/" target="_blank" rel="noopener noreferrer" class="bold-link">katalog khusus souvenir pernikahan</a> untuk melihat inspirasi tema dekorasi, galeri produk pouch dan clutch, ide hadiah fungsional, serta kalkulator estimasi budget pernikahan yang lebih mendalam.
      </p>
    </section>

    <!-- 6. BERLOKASI DI MALANG DAN MELAYANI PENGIRIMAN -->
    <section class="content-section">
      <span class="section-tag">LOKASI DAN JANGKAUAN</span>
      <h2>Berlokasi di Malang dan Melayani Pengiriman</h2>
      <p>
        Sekata berakar dan beroperasi dari kota Malang, Jawa Timur. Lokasi operasional kami berada di:
      </p>

      <div class="location-card">
        <div class="location-icon">
          <Icon name="pin" size={28} />
        </div>
        <div class="location-info">
          <h3>Alamat Sekata</h3>
          <p><strong>Jalan Bandara Palmerah, Cemorokandang, Malang, Jawa Timur 65138</strong></p>
          <p class="location-desc">
            Kami melayani pengantaran langsung kurir lokal untuk wilayah Malang Raya (Kota Malang, Kota Batu, dan Kabupaten Malang seperti Kepanjen dan Singosari). Selain itu, kami secara rutin mendistribusikan pesanan ke berbagai kota di Jawa Timur (Surabaya, Sidoarjo, Kediri) hingga luar pulau seperti Jakarta, Bandung, Denpasar Bali, Makassar, Balikpapan, dan Medan menggunakan armada kargo terpercaya yang terproteksi rapi.
          </p>
          <a href={map} target="_blank" rel="noopener noreferrer" class="map-button">
            Buka di Google Maps <Icon name="pin" size={16} />
          </a>
        </div>
      </div>
    </section>

    <!-- 7. CTA SECTION -->
    <section class="cta-banner">
      <span class="eyebrow-light">KONSULTASI GRATIS BERSAMA AYU</span>
      <h2>Ceritakan Kebutuhan Hadiahmu kepada Sekata</h2>
      <p class="cta-desc">
        Sampaikan jenis acara, jumlah kebutuhan, tanggal acara, dan kota tujuan. Ayu akan membantu mendiskusikan pilihan produk, personalisasi, serta kemasan yang sesuai.
      </p>
      <div class="cta-actions">
        <a href={wa + '?text=' + encodeURIComponent('Halo Kak Ayu, saya ingin konsultasi kebutuhan hadiah custom di Sekata.')} class="btn-primary" target="_blank" rel="noopener noreferrer">
          Konsultasi dengan Ayu <Icon size={16} />
        </a>
        <a href="/gift/" class="btn-secondary">
          Jelajahi Koleksi Gift
        </a>
      </div>
    </section>
  </article>
</Layout>

<style>
  .about-container {
    max-width: 880px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
    color: var(--ink, #2c2523);
    line-height: 1.8;
  }

  .page-hero {
    position: relative;
    padding: 62px 6% 48px;
    background-color: #f6f1e8;
    background-image: 
      linear-gradient(90deg, rgba(253, 250, 246, 0.98) 0%, rgba(253, 250, 246, 0.94) 45%, rgba(253, 250, 246, 0.75) 70%, rgba(253, 250, 246, 0.2) 100%),
      var(--page-hero-bg, url('/images/hero-mawar-gading.png'));
    background-size: cover;
    background-position: right center;
    background-repeat: no-repeat;
    overflow: hidden;
  }

  .breadcrumbs {
    font-size: 0.875rem;
    color: var(--muted, #6f625b);
    margin-bottom: 1.25rem;
  }

  .breadcrumbs a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumbs a:hover {
    color: var(--rust, #aa5636);
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--rust, #aa5636);
    margin-bottom: 0.75rem;
  }

  .page-hero h1 {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    max-width: 820px;
    margin-bottom: 0.75rem;
    color: var(--ink, #2c2523);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .hero-tagline {
    font-size: 1.15rem;
    font-style: italic;
    color: var(--rust, #aa5636);
    margin: 0;
    font-weight: 500;
  }

  .intro-card {
    background: #ffffff;
    border: 1px solid rgba(170, 86, 54, 0.15);
    border-left: 4px solid var(--rust, #aa5636);
    border-radius: 8px;
    padding: 1.75rem 2rem;
    margin-bottom: 3.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  .intro-text {
    font-size: 1.05rem;
    line-height: 1.85;
    color: var(--ink, #2c2523);
    margin: 0;
  }

  .content-section {
    margin-bottom: 3.5rem;
  }

  .section-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--rust, #aa5636);
    margin-bottom: 0.5rem;
  }

  .content-section h2 {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 600;
    color: var(--ink, #2c2523);
    margin-bottom: 1.25rem;
    line-height: 1.35;
  }

  .content-section p {
    font-size: 1rem;
    color: #4a403b;
    margin-bottom: 1.25rem;
  }

  /* CATEGORY CARDS */
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-top: 1.75rem;
  }

  .category-card {
    background: #ffffff;
    border: 1px solid #ebdcd5;
    border-radius: 10px;
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .category-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(170, 86, 54, 0.08);
  }

  .card-icon {
    color: var(--rust, #aa5636);
    margin-bottom: 1rem;
  }

  .category-card h3 {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--ink, #2c2523);
    margin-bottom: 0.75rem;
  }

  .category-card p {
    font-size: 0.925rem;
    color: #5a504a;
    line-height: 1.65;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--rust, #aa5636);
    text-decoration: none;
    transition: gap 0.2s ease;
  }

  .card-link:hover {
    gap: 0.65rem;
    text-decoration: underline;
  }

  /* STEPS GRID */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-top: 1.75rem;
  }

  .step-card {
    background: #faf8f5;
    border: 1px solid #ebdcd5;
    border-radius: 10px;
    padding: 1.75rem 1.5rem;
    position: relative;
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--rust, #aa5636);
    color: #ffffff;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 50%;
    margin-bottom: 1rem;
  }

  .step-card h3 {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--ink, #2c2523);
    margin-bottom: 0.6rem;
  }

  .step-card p {
    font-size: 0.925rem;
    color: #5a504a;
    line-height: 1.65;
    margin: 0;
  }

  /* DETAIL LIST */
  .detail-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }

  .detail-list li {
    padding: 1rem 1.25rem;
    margin-bottom: 0.75rem;
    background: #ffffff;
    border: 1px solid #eee5df;
    border-radius: 8px;
    font-size: 0.95rem;
    color: #4a403b;
    line-height: 1.7;
  }

  .detail-list li strong {
    color: var(--ink, #2c2523);
  }

  /* HIGHLIGHT BOX (KATALOG SOUVENIR PERNIKAHAN) */
  .highlight-box {
    background: #fbf7f4;
    border: 1.5px solid #dfc7bc;
    border-radius: 12px;
    padding: 2.25rem 2rem;
  }

  .highlight-text {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--ink, #2c2523);
    line-height: 1.8;
  }

  .bold-link {
    color: var(--rust, #aa5636);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .bold-link:hover {
    color: #8c3f22;
  }

  /* LOCATION CARD */
  .location-card {
    display: flex;
    gap: 1.5rem;
    background: #ffffff;
    border: 1px solid #ebdcd5;
    border-radius: 10px;
    padding: 2rem;
    margin-top: 1.5rem;
  }

  .location-icon {
    color: var(--rust, #aa5636);
    flex-shrink: 0;
    margin-top: 0.25rem;
  }

  .location-info h3 {
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .location-desc {
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0.75rem 0 1.25rem;
  }

  .map-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--rust, #aa5636);
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.65rem 1.25rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .map-button:hover {
    background: #8c3f22;
  }

  /* CTA BANNER */
  .cta-banner {
    background: linear-gradient(135deg, #aa5636 0%, #8c3f22 100%);
    color: #ffffff;
    border-radius: 14px;
    padding: 3rem 2rem;
    text-align: center;
    margin-top: 4rem;
  }

  .eyebrow-light {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: #f7ded3;
    margin-bottom: 0.75rem;
  }

  .cta-banner h2 {
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .cta-desc {
    font-size: 1rem;
    color: #fbece6;
    max-width: 650px;
    margin: 0 auto 2rem;
    line-height: 1.75;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    color: var(--rust, #aa5636);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.85rem 1.75rem;
    border-radius: 8px;
    text-decoration: none;
