---
import Layout from '../layouts/Layout.astro';import Icon from '../components/Icon.astro';import ProductCard from '../components/ProductCard.astro';import CoupleShowcase from '../components/CoupleShowcase.astro';import {products,articles,wa,config} from '../data/site';
const faqs=[['Apakah souvenir bisa dipersonalisasi?','Pilihan isi, warna, nama, dan kemasan dapat dikonsultasikan dengan Ayu. Ketersediaan personalisasi mengikuti produk dan jumlah pesanan.'],['Bagaimana mengetahui harga dan minimum pesanan?','Tambahkan pilihan ke keranjang lalu kirim ringkasannya ke WhatsApp Ayu. Harga, minimum pesanan, dan estimasi produksi dikonfirmasi sesuai kebutuhanmu.'],['Apakah Sekata melayani pengiriman ke luar Malang?','Konsultasikan kebutuhan pengiriman ke Surabaya, Jakarta, Bandung, Makassar, Bali, Lombok, Banjarmasin, dan kota tujuan lainnya bersama Ayu.'],['Kapan sebaiknya memesan souvenir pernikahan?','Hubungi admin setelah tanggal acara dan estimasi jumlah kebutuhan tersedia. Waktu produksi dan pengiriman perlu dikonfirmasi sebelum pesanan disepakati.']];
---
<Layout title="Sekata — Souvenir Pernikahan & Hampers Custom Malang" schema={{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}}>
<section class="hero">{config.heroVideo?<video autoplay muted loop playsinline preload="auto"><source src={config.heroVideo} type="video/mp4"/></video>:<img class="hero-bg" src={config.heroImage} alt="Hadiah terbungkus dengan pita untuk momen istimewa" width="1800" height="1200" fetchpriority="high"/>}<div class="hero-shade"></div><div class="hero-content"><span class="eyebrow">THOUGHTFULLY GIVEN. BEAUTIFULLY REMEMBERED.</span><h1>Satu hadiah.<br/>Sejuta <span>makna.</span></h1><p>Untuk ucapan terima kasih, perayaan cinta,<br class="desktop-break"/> dan semua momen yang layak dikenang.</p><a class="button light" href="/gift/">Temukan Gift Pilihanmu <Icon/></a><span class="hero-note">Souvenir · Hampers · Personal Gift</span></div><div class="hero-bottom"><span>DIRANGKAI DENGAN RASA, DARI MALANG.</span><span>01 <i></i> 03</span></div></section>
<section class="trust-strip"><p>Dipercaya <strong>250+ brand & institusi</strong></p>{config.clients.length?<div class="logo-window"><div class="logo-track">{[...config.clients,...config.clients].map(c=><img src={c.logo} alt={c.name} width="130" height="50" loading="lazy"/>)}</div></div>:<div class="trust-values"><span>Dirancang personal</span><span>Detail yang berarti</span><span>Untuk beragam momen</span></div>}</section>
<section class="section collections"><div class="section-heading"><div><span class="eyebrow">THE ART OF THOUGHTFUL GIVING</span><h2>Apa pun momennya,<br/>ada Sekata.</h2></div><p>Hadiah yang tepat berawal dari perhatian.<br/>Temukan inspirasi yang paling dekat<br/>dengan cerita dan orang-orangmu.</p></div><div class="category-grid"><a class="category-card large" href="/souvenir-wedding/"><img src="/images/ceramic.jpg" alt="Inspirasi keramik untuk souvenir wedding" width="900" height="900" loading="lazy"/><div><span>UNTUK HARI PENUH CINTA</span><h3>Wedding Souvenir</h3><span class="round-arrow"><Icon/></span></div></a><a class="category-card" href="/hampers/"><img src="/images/hampers.jpg" alt="Inspirasi hampers dengan kemasan hadiah" width="700" height="900" loading="lazy"/><div><span>SEBUAH PERHATIAN KECIL</span><h3>Hampers & Gift</h3><span class="round-arrow"><Icon/></span></div></a><a class="category-card" href="/souvenir-perusahaan/"><img src="/images/gift.jpg" alt="Inspirasi gift untuk apresiasi perusahaan" width="700" height="900" loading="lazy"/><div><span>APRESIASI YANG BERARTI</span><h3>Corporate Gift</h3><span class="round-arrow"><Icon/></span></div></a></div></section>
<section class="section favorites"><div class="section-heading"><div><span class="eyebrow">A FEW THOUGHTFUL FINDS</span><h2>Kenalan dengan pilihan kami.</h2></div><a href="/gift/" class="text-link">Jelajahi semua gift <Icon/></a></div><p class="catalog-note">Konsep koleksi untuk inspirasimu. Foto merupakan ilustrasi; isi, material, dan ketersediaan dikonfirmasi bersama admin.</p><div class="products-grid">{products.map(p=><ProductCard product={p}/>)}</div><div class="center"><a href={wa} class="text-link">Punya ide sendiri? Ceritakan ke Ayu <Icon/></a></div></section>
<CoupleShowcase />
<section class="section process"><div class="section-heading"><div><span class="eyebrow">FROM YOUR IDEA TO THEIR SMILE</span><h2>Cara pesan di Sekata.</h2></div><p>Kamu bawa ceritanya.<br/>Kita bicarakan detailnya bersama.</p></div><div class="steps">{[['Pilih yang kamu suka','Jelajahi koleksi, lalu simpan inspirasi ke keranjang pilihanmu.'],['Ceritakan kebutuhanmu','Kirim ringkasan ke Ayu. Diskusikan jumlah, konsep, tanggal, dan tujuan.'],['Sepakati setiap detail','Konfirmasikan isi, desain, penawaran, dan jadwal sebelum produksi.'],['Siap berbagi kebahagiaan','Koordinasikan penyelesaian dan pengiriman bersama admin.']].map(([title,text],i)=><div><span class="step-number">0{i+1}</span><h3>{title}</h3><p>{text}</p></div>)}</div></section>
<section class="brand-story"><div class="story-image"><img src="/images/pouch.jpg" alt="Ilustrasi tas sebagai inspirasi hadiah personal" width="1000" height="1000" loading="lazy"/><span class="image-caption">A LITTLE DETAIL. A LASTING FEELING.</span></div><div class="story-copy"><span class="eyebrow">SEBUAH CERITA TENTANG RASA</span><h2>Bukan sekadar memberi.<br/>Tapi menyampaikan<br/>yang ada di hati.</h2><p>Ada terima kasih yang sulit diucapkan. Ada kebahagiaan yang ingin dibagikan. Ada momen yang ingin disimpan lebih lama.</p><p>Sekata hadir untuk membantu merangkai perhatian itu menjadi hadiah—melalui pilihan isi, warna, dan kemasan yang terasa dekat dengan ceritamu.</p><a class="text-link" href="/sekata/">Lebih dekat dengan Sekata <Icon/></a></div></section>
<section class="testimonials section"><span class="eyebrow">GOOD WORDS, WARM HEARTS</span><h2>Cerita setelah hadiah sampai.</h2>{config.testimonials.length?config.testimonials.map(t=><blockquote><p>“{t.quote}”</p><cite>{t.name} · {t.event}</cite></blockquote>):<div class="testimonial-empty"><Icon name="chat" size={36}/><p>Setiap hadiah punya cerita.<br/>Kami ingin mendengar ceritamu.</p><a class="text-link" href={wa+'?text='+encodeURIComponent('Halo Kak Ayu, saya ingin berbagi pengalaman memesan di Sekata.')}>Bagikan pengalamanmu <Icon/></a></div>}</section>
<section class="section journal"><div class="section-heading"><div><span class="eyebrow">THE SEKATA JOURNAL</span><h2>Sedikit inspirasi, banyak arti.</h2></div><a class="text-link" href="/blog/">Temukan solusi <Icon/></a></div><div class="article-grid">{articles.map(a=><a class="article-card" href={'/blog/'+a.slug+'/'}><img src={'/images/'+a.image} alt={'Ilustrasi '+a.category} width="700" height="500" loading="lazy"/><span class="eyebrow">{a.category} · 7 November 2026</span><h3>{a.title}</h3><span class="text-link">Baca ceritanya <Icon size={18}/></span></a>)}</div></section>
<section class="section faq"><div><span class="eyebrow">BEFORE WE BEGIN</span><h2>Mungkin ini<br/>yang kamu tanyakan.</h2><a class="text-link" href={wa}>Tanya Ayu langsung <Icon/></a></div><div>{faqs.map(([q,a])=><details><summary>{q}<Icon name="plus" size={18}/></summary><p>{a}</p></details>)}</div></section>
</Layout>
